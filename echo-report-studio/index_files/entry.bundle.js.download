 if(!usable('pvs')||!usable('pvd'))d.sd=null;
 if(!usable('arDuration')||!usable('aDuration'))d.arDiff=null;
 if(!usable('valsalvaEA')||!positive(d.e)||!positive(d.a))d.valsalvaDrop=null;
 d.paedp=usable('paDirect')&&present(n('paDirect'))?n('paDirect'):present(n('pred'))&&present(d.rap)?n('pred')+d.rap:null;
 return d;
};

// Editing a measurement explicitly reactivates its numeric value; N/A selections still exclude it from grading.
