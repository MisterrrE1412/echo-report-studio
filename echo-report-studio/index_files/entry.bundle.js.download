/* chamber-editor.js */
(function(){
 const panels=[];
 for(const [key,sizeId,title]of [['lv','lvsize','LV dimensions & volumes'],['la','la','LA dimensions, area & LAVI'],['ra','ra','RA dimensions, area & volume'],['rv','rvsize','RV dimensions & areas']]){
  const panel=document.createElement('details');panel.className='wide chamber-measurements';panel.innerHTML='<summary>'+title+'</summary>';const grid=document.createElement('div');grid.className='grid';panel.append(grid);$(sizeId).parentElement.after(panel);
  for(const [id,label,unit]of chamberFields[key])grid.append(field(id,label+' ('+unit+')','number'));
  if(key==='la')for(const id of ['lavol','lamethod','laviDirect']){const label=$(id).closest('.field');grid.append(label);label.querySelectorAll('input,select,textarea,button').forEach(el=>el.disabled=false);}
  if(key==='lv'){const note=document.createElement('p');note.className='wide hint';note.textContent='LVIDd is entered in the LV section above. Volumes below are measured by biplane method; they do not replace the selected LVEF method.';grid.prepend(note);}
  const result=document.createElement('p');result.className='wide hint';grid.append(result);
  const record={key,sizeId,panel,result,last:null};panels.push(record);
  $(sizeId).addEventListener('change',()=>{if(v(sizeId)==='Dilated')panel.open=true;});
 }
 // LA measurements are shared with the diastolic engine, not copied into separate fields.
 const link=document.createElement('button');link.type='button';link.textContent='Enter LA volume / LAVI in chamber measurements';link.onclick=()=>{const panel=panels.find(p=>p.key==='la').panel;for(let el=panel;el;el=el.parentElement)if(el.tagName==='DETAILS')el.open=true;panel.scrollIntoView({block:'center'});if(typeof MeasurementUnits!=='undefined'&&MeasurementUnits.focus)MeasurementUnits.focus('laviDirect');else $('laviDirect').focus();};$('laReliable').closest('.field').before(link);
 function refresh(){const c=calculate();for(const item of panels){const marked=v(item.sizeId)==='Dilated';if(marked&&item.last!==true)item.panel.open=true;item.last=marked;item.result.textContent=item.key==='la'?(c.lavi?'LAVI: '+r(c.lavi,1)+' mL/m².':'Enter measured LAVI directly, or measured LA volume plus height/weight or BSA.'):item.key==='ra'?(positive(n('raVolume'))&&c.b?'RA volume index: '+r(n('raVolume')/c.b,1)+' mL/m².':'Dimensions and area are optional. BSA is needed to index RA volume.'):item.key==='lv'?(positive(n('lvEdv'))&&c.b?'LV EDV index: '+r(n('lvEdv')/c.b,1)+' mL/m².':'BSA is needed to index LV volumes.'):'Use an RV-focused apical view for RV dimensions and areas.';}}
 $('form').addEventListener('clinicalupdate',refresh);
 const restore=restoreStudy;restoreStudy=function(record){restore(record);for(const item of panels){item.last=null;item.panel.open=v(item.sizeId)==='Dilated'||chamberFields[item.key].some(([id])=>v(id));}refresh();};refresh();
})();

