/* study-planner.js */
// Adult acquisition planner; checklist state is separate from clinical measurements and report output.
(function(){
const P=StudyProtocols,form=$('form'),host=document.createElement('section');host.className='card study-planner';host.id='studyPlanner';form.prepend(host);
const make=(tag,cls,text)=>{const e=document.createElement(tag);if(cls)e.className=cls;if(text)e.textContent=text;return e;};
const head=make('div','cardhead');head.append(make('span','step','00'),make('h2','','Plan this study'));host.append(head);
host.append(make('p','planner-intro','What is the clinical question? Choose a guide to see useful views, measurements and Doppler modes.'));
const chooser=make('details','planner-shell');chooser.id='studyGuideChooser';chooser.open=true;const chooserTitle=make('summary','','Choose an indication / study guide');chooser.append(chooserTitle);host.append(chooser);
const searchLabel=make('label','field','Search the requested study');const search=document.createElement('input');search.id='studyGuideQuery';search.type='search';search.placeholder='For example: PE, aortic stenosis, MR, heart failure';search.autocomplete='off';searchLabel.append(search);chooser.append(searchLabel);
const results=make('div','planner-matches');results.setAttribute('aria-label','Matching study guides');chooser.append(results);
const pickLabel=make('label','field','Or choose from all guides');const pick=document.createElement('select');pick.setAttribute('aria-label','All adult study guides');pick.append(new Option('Select a study guide',''));P.protocols.forEach(p=>pick.append(new Option(p.title,p.id)));pickLabel.append(pick);chooser.append(pickLabel);
const infer=document.createElement('button');infer.type='button';infer.textContent='Find guides from clinical indication';infer.onclick=()=>{search.value=v('indication');renderMatches();persist();};chooser.append(infer);
const hidden=document.createElement('input');hidden.type='hidden';hidden.id='studyGuideState';hidden.name='studyGuideState';host.append(hidden);
const content=make('div','planner-content');content.id='studyGuideContent';host.append(content);let state=P.cleanState(''),activeProgress=null,activeNext=null,activePrompt=null;
const fold=document.createElement('button');fold.type='button';fold.className='planner-fold';fold.textContent='Hide guide';fold.setAttribute('aria-expanded','true');fold.setAttribute('aria-controls','studyGuideChooser studyGuideContent');fold.onclick=()=>{const closed=!chooser.hidden;chooser.hidden=closed;content.hidden=closed;fold.textContent=closed?'Show guide':'Hide guide';fold.setAttribute('aria-expanded',String(!closed));};head.append(fold);
function persist(){hidden.value=JSON.stringify(state);if(typeof saveRecoveryDraft==='function'){hasDraftActivity=true;saveRecoveryDraft();}}
// Checklist/search changes save for recovery without making an unchanged report stale.
host.addEventListener('input',e=>{e.stopPropagation();persist();});host.addEventListener('change',e=>{e.stopPropagation();persist();});
function renderMatches(){results.replaceChildren();const query=search.value.trim(),matches=P.search(query);if(!query){results.append(make('p','hint','Common guides'));['pe','as','hf','mr'].forEach(id=>results.append(matchButton(P.protocols.find(p=>p.id===id))));return;}
 if(!matches.length){results.append(make('p','hint','No specific protocol found. Choose comprehensive adult TTE and discuss additional acquisitions with your supervisor.'));results.append(matchButton(P.protocols[0]));return;}
 for(const p of matches)results.append(matchButton(p));
}
function matchButton(p){const b=document.createElement('button');b.type='button';b.textContent=p.title;b.onclick=()=>select(p.id);return b;}
search.addEventListener('input',renderMatches);search.addEventListener('keydown',e=>{if(e.key==='Enter'){e.preventDefault();renderMatches();results.querySelector('button')?.focus();}});
pick.onchange=()=>select(pick.value);
function select(id){state.selected=P.protocols.some(p=>p.id===id)?id:'';state.states[state.selected]||={};render();persist();chooserTitle.focus();}
function jump(field){if(typeof openValve==='function'&&['valves','mv','av','tv','pv'].includes(field))openValve(field==='valves'?'mv':field);const target=field==='valves'?$('mv').closest('details'):$(field);if(!target){toast('Record this measurement in the relevant findings section.');return;}if(target.tagName==='DETAILS')target.open=true;let parent=target.parentElement;while(parent){if(parent.tagName==='DETAILS')parent.open=true;parent=parent.parentElement;}const container=target.closest('details')||target;container.scrollIntoView({block:'start'});if(target.type==='number'&&typeof MeasurementUnits!=='undefined'&&MeasurementUnits.focus)MeasurementUnits.focus(field,{preventScroll:true});else if(!target.disabled&&!target.closest('[hidden]'))(target.tagName==='DETAILS'?target.querySelector('summary'):target).focus({preventScroll:true});}
function referenceLink(key){const ref=P.refs[key],a=document.createElement('a');a.href=ref.url;a.textContent=ref.title;a.target='_blank';a.rel='noopener';return a;}
function diagram(key){const figure=make('figure','planner-view');const source=StudyGuideFigures[key];let title=source?.title||EchoViews.titles[key];if(key==='a4c')title='A4C orientation — adjust for an RV-focused view';figure.append(make('figcaption','',title));const body=make('div');body.innerHTML=source?source.svg:EchoViews.render(key);
 // Static study illustrations never read scores or become print/report wall-motion diagrams.
 for(const g of body.querySelectorAll('[data-segment]')){g.removeAttribute('tabindex');g.removeAttribute('role');g.removeAttribute('data-segment');g.querySelectorAll('text,title').forEach(t=>t.remove());g.querySelector('[data-wall]')?.removeAttribute('data-wall');}
 body.querySelector('svg').setAttribute('aria-label',title+' schematic');figure.append(body);return figure;
}
function refreshProgress(){if(!state.selected||!activeProgress)return;const p=P.protocols.find(p=>p.id===state.selected),s=state.states[p.id]||{},pr=P.progress(p.id,s);
 activeProgress.textContent=pr.done+'/'+pr.total+' core acquisitions reviewed · '+pr.pending+' pending'+(pr.unavailable?' · '+pr.unavailable+' not measurable':'')+(pr.unreliable?' · '+pr.unreliable+' unreliable':'')+(pr.na?' · '+pr.na+' not applicable':'');
 activeNext.replaceChildren();activeNext.append(make('strong','','NEXT USEFUL ACQUISITION'));
 if(pr.next){activeNext.append(make('p','',pr.next.title),make('small','',pr.next.mode+' · '+pr.next.view));}
 else if(pr.unavailable||pr.unreliable){activeNext.append(make('p','','Review the unavailable or unreliable acquisitions with your supervisor; document the limitation or choose a suitable alternative.'));}
 else activeNext.append(make('p','','Core checklist reviewed. Consider additional acquisitions if the clinical question remains unanswered. Checklist completion is not a diagnosis.'));
 if(activePrompt)activePrompt.value=P.discussionPrompt(p.id,s);
}
function itemRow(item,p){const row=make('div','planner-item');row.dataset.acquisition=item.id;const top=make('div','planner-item-top');top.append(make('strong','',item.title),make('span','mode-badge',item.mode));row.append(top,make('p','acquisition-window',item.view),make('p','acquisition-tip',item.tip));
 const actions=make('div','acquisition-actions');const label=make('label','field','Acquisition status'),status=document.createElement('select');status.setAttribute('aria-label',item.title+' acquisition status');for(const [value,title]of Object.entries(P.statusLabels))status.append(new Option(title,value));status.value=state.states[p.id]?.[item.id]||'pending';row.dataset.status=status.value;label.append(status);actions.append(label);
 status.onchange=()=>{state.states[p.id]||={};state.states[p.id][item.id]=status.value;row.dataset.status=status.value;refreshProgress();};
 if(item.field){const go=document.createElement('button');go.type='button';go.textContent=item.field==='valves'?'Open valve section':'Go to report field';go.onclick=()=>jump(item.field);actions.append(go);}row.append(actions);return row;
}
function render(){content.replaceChildren();activeProgress=activeNext=activePrompt=null;pick.value=state.selected;const p=P.protocols.find(p=>p.id===state.selected);chooserTitle.textContent=p?'Study guide: '+p.title+' · change':'Choose an indication / study guide';
 if(!p){content.append(make('p','hint','Adult resting TTE guides. Select the referral question; no diagnosis is assumed from the study name.'));return;}
 chooser.open=false;
 const intro=make('div','planner-selected');intro.append(make('h3','',p.title),make('p','',p.aim));content.append(intro);
 content.append(make('p','planner-scope','Add these targeted acquisitions to the usual comprehensive TTE, unless a limited study is specifically requested. Adapt to patient stability, image quality and local protocol.'));
 activeProgress=make('p','planner-progress');activeProgress.setAttribute('role','status');activeNext=make('div','planner-next');content.append(activeProgress,activeNext);
 const check=make('details','planner-acquisitions');check.open=true;check.append(make('summary','','Core acquisition checklist'));p.items.filter(x=>!x.optional).forEach(item=>check.append(itemRow(item,p)));content.append(check);
 const optional=p.items.filter(x=>x.optional);if(optional.length){const more=make('details','planner-acquisitions');more.append(make('summary','','Additional acquisitions — when useful'));optional.forEach(item=>more.append(itemRow(item,p)));content.append(more);}
 content.append(make('p','planner-caution',p.caution));
 const illustrations=make('details','planner-illustrations');illustrations.append(make('summary','','View pictures and Doppler guide'));content.append(illustrations);let painted=false;
 illustrations.addEventListener('toggle',()=>{if(!illustrations.open||painted)return;painted=true;illustrations.append(make('p','hint','Orientation schematics, not patient images or exact sample-gate positions. Use the source guideline for detailed acquisition figures.'));
 const gallery=make('div','planner-gallery');p.views.forEach(key=>gallery.append(diagram(key)));illustrations.append(gallery,diagram('modes'));
 const help=make('dl','doppler-glossary');for(const [mode,description]of Object.entries(P.modes)){help.append(make('dt','',mode),make('dd','',description));}illustrations.append(help,make('p','hint','TR is entered in cm/s in this report: 280 cm/s = 2.8 m/s. AS Vmax uses m/s; VTI uses cm.'));
 });
 const links=make('details','planner-references');links.append(make('summary','','References and scope'));const list=make('ul');p.refs.forEach(key=>{const li=document.createElement('li');li.append(referenceLink(key));list.append(li);});links.append(list,make('p','hint','Curated acquisition guide reviewed 12 October 2026. Guideline publication years are shown above. This is not an automatic diagnosis or a complete protocol for children, congenital disease, stress echo or procedural studies.'));content.append(links);
 const discussion=make('details','planner-discussion');discussion.append(make('summary','','Prepare a discussion in ChatGPT'),make('p','hint','Copies only this guide and its acquisition status. Add de-identified findings yourself. This opens a separate conversation; there is no built-in AI chat.'));
 activePrompt=document.createElement('textarea');activePrompt.readOnly=true;activePrompt.setAttribute('aria-label','Study discussion prompt');discussion.append(activePrompt);
 const copy=document.createElement('button');copy.type='button';copy.textContent='Copy discussion prompt';copy.onclick=async()=>{try{if(navigator.clipboard?.writeText)await navigator.clipboard.writeText(activePrompt.value);else copyFallback(activePrompt.value);toast('Study prompt copied. No patient fields included.');}catch{activePrompt.focus();activePrompt.select();toast('Select and copy the prompt manually.');}};
 const open=document.createElement('a');open.href='https://chatgpt.com/';open.target='_blank';open.rel='noopener';open.textContent='Open ChatGPT';const discussionActions=make('div','actions');discussionActions.append(copy,open);discussion.append(discussionActions);content.append(discussion);
 content.append(make('p','hint','Checklist status saves with this study. It does not enter the patient report or set measurements to normal.'));
 refreshProgress();
}
const restore=restoreStudy;restoreStudy=function(record){hidden.value='';restore(record);state=P.cleanState(hidden.value);hidden.value=JSON.stringify(state);renderMatches();render();};
renderMatches();render();
})();

;
/* great-arteries-editor.js */
/* Small, browser-local great-artery editor. Existing study snapshots capture every named field. */
(function(){
 'use strict';
 const grid=section('Great arteries · aorta & pulmonary artery',[]);
 const parent=grid.parentElement;parent.classList.add('great-arteries');parent.dataset.shortcut='Great arteries';
 const intro=document.createElement('p');intro.className='wide note';intro.textContent='Pilih Aorta atau Pulmonary artery. Masukkan diameter dalam cm; contoh 32 mm = 3.2 cm. Pilih normal hanya selepas struktur dinilai.';grid.append(intro);
 const nav=document.createElement('div');nav.className='wide artery-tabs';nav.setAttribute('role','group');nav.setAttribute('aria-label','Great artery to assess');grid.append(nav);
 const panels={},buttons={},feedback={};
 for(const [key,title,caption]of [['aorta','Aorta','Root · ascending · annulus · STJ'],['pa','Pulmonary artery','Main PA · optional branches']]){
  const button=document.createElement('button');button.type='button';button.textContent=title;button.setAttribute('aria-controls','gaPanel-'+key);nav.append(button);buttons[key]=button;
  const panel=document.createElement('div');panel.id='gaPanel-'+key;panel.className='wide artery-panel';panels[key]=panel;grid.append(panel);
  const heading=document.createElement('h3');heading.textContent=title;const sub=document.createElement('p');sub.className='artery-caption';sub.textContent=caption;panel.append(heading,sub);
  const method=document.createElement('p');method.className='artery-method';method.textContent=key==='aorta'?'2D TTE · Root / STJ / ascending: end-diastole, leading edge to leading edge. Annulus: midsystole, inner edge to inner edge.':'2D TTE · PA-focused PSAX, end-diastole. MPA: ukur di pertengahan pulmonary valve dan PA bifurcation.';panel.append(method);
  const main=document.createElement('div');main.className='artery-sites';panel.append(main);
  const extra=document.createElement('details');extra.className='artery-extra';const summary=document.createElement('summary');summary.textContent=key==='aorta'?'Other aortic levels & measurement location (optional)':'Right / left PA branches (optional)';extra.append(summary);panel.append(extra);
  const more=document.createElement('div');more.className='artery-sites';extra.append(more);
  for(const site of GreatArteries.sites.filter(s=>s.group===key)){
   const card=document.createElement('div');card.className='artery-site';const title=document.createElement('h4');title.textContent=site.name;card.append(title);
   const row=document.createElement('div');row.className='grid';card.append(row);
   row.append(field(site.id,'Diameter (cm)','number'));
   const options=[['',site.key==='mpa'?'Auto · ASE adult category':'Measurement only'],['normal','Normal size · confirmed'],['dilated','Dilated · confirmed']];
   if(site.key==='mpa')options.push(['measurement','Measurement only · no automatic category']);
   options.push(['notmeasurable','Not measurable / poor view'],['unreliable','Unreliable measurement'],['na','Not applicable']);
   row.append(field(site.id+'State','Size assessment','select',options));
   const help=document.createElement('details');help.className='artery-help';const label=document.createElement('summary');label.textContent='Where & how to measure';help.append(label);
   const meaning=document.createElement('p');meaning.textContent=site.meaning;const tip=document.createElement('p');tip.textContent=site.tip;const example=document.createElement('p');example.className='artery-example';example.textContent='Contoh ayat: '+site.example;help.append(meaning,tip,example);card.append(help);
   const result=document.createElement('p');result.id=site.id+'Feedback';result.className='artery-feedback';result.setAttribute('aria-live','polite');card.append(result);feedback[site.key]=result;
   (site.extra?more:main).append(card);
   $(site.id).setAttribute('aria-describedby',result.id);$(site.id+'State').setAttribute('aria-describedby',result.id);
  }
  if(key==='aorta'){
   more.append(field('gaAscendingDistance','Ascending measurement distance above STJ (cm)','number'));
   const note=document.createElement('p');note.className='hint';note.textContent='Interpretasi saiz aorta mengambil kira umur, jantina dan saiz badan. Indeks diameter/BSA ialah ukuran tambahan, bukan gred severity automatik. Gred saiz MPA tidak digunakan untuk aorta.';panel.append(note);
  }else{
   const note=document.createElement('p');note.className='hint';note.textContent='ASE 2025 Table 1 (adult MPA): <2.5 cm normal; 2.5–3.0 mild; >3.0–3.5 moderate; >3.5 severe enlargement. Saiz PA sahaja tidak menentukan pulmonary hypertension. Cut-off ini tidak digunakan untuk RPA / LPA atau kanak-kanak.';panel.append(note);
   const boundary=document.createElement('details');boundary.className='artery-help';boundary.innerHTML='<summary>Reference note · 2.5 cm boundary</summary><p>Table 1 meletakkan 2.5 cm dalam mild enlargement; teks guideline menyatakan &gt;25 mm abnormal. Auto category menggunakan Table 1 secara konsisten. Semak nilai sempadan dalam konteks klinikal.</p>';panel.append(boundary);
  }
  button.onclick=()=>show(key);
 }
 function show(key){for(const k of Object.keys(panels)){panels[k].hidden=k!==key;buttons[k].setAttribute('aria-pressed',String(k===key));}}
 show('aorta');
 const notes=field('gaNotes','Other great artery findings (optional)','textarea');grid.append(notes);
 const sources=document.createElement('details');sources.className='wide artery-help';sources.innerHTML='<summary>Acquisition references</summary><p><a href="https://www.asecho.org/wp-content/uploads/2016/02/2015_ChamberQuantificationREV.pdf" target="_blank" rel="noopener">ASE/EACVI chamber quantification 2015 · aorta, §§11–13</a></p><p><a href="https://www.asecho.org/wp-content/uploads/2019/01/2019_Comprehensive-TTE.pdf" target="_blank" rel="noopener">ASE comprehensive TTE 2019 · aortic acquisition</a></p><p><a href="https://www.asecho.org/wp-content/uploads/2025/03/PIIS0894731725000379.pdf" target="_blank" rel="noopener">ASE right heart 2025 · Tables 1–2, pulmonary artery</a></p>';grid.append(sources);
 window.greatArteryAssessment=function(){return GreatArteries.assess({measurements:Object.fromEntries(GreatArteries.sites.map(site=>[site.key,{value:n(site.id),state:v(site.id+'State')}])),bsa:calculate().b,age:n('age'),ascendingDistance:n('gaAscendingDistance'),notes:v('gaNotes')});};
 function refresh(){
  const result=greatArteryAssessment();
  for(const site of GreatArteries.sites){
   const row=result.rows[site.key],parts=[];
   if(row.state==='notmeasurable')parts.push('Tidak dapat diukur dengan yakin. Nilai yang tersimpan tidak digunakan dalam laporan.');
   else if(row.state==='unreliable')parts.push('Ukuran tidak reliable; tidak digunakan untuk indeks atau interpretasi saiz.');
   else if(row.state==='na')parts.push('Tidak digunakan dalam laporan.');
   else if(row.usable){
    parts.push(Number((row.value*10).toFixed(2))+' mm.');
    if(row.index!==null)parts.push('Diameter / BSA: '+row.index.toFixed(2)+' cm/m².');
    if(row.grade)parts.push('ASE 2025 Table 1: '+(row.grade==='Normal'?'normal size':row.grade.toLowerCase()+' enlargement')+'.');
    else if(site.key==='mpa'&&n('age')>0&&n('age')<18)parts.push('Adult category tidak digunakan untuk umur <18 tahun.');
    else if(!row.state||row.state==='measurement')parts.push('Ukuran direkodkan tanpa kategori saiz automatik.');
    if(row.state==='normal')parts.push('Normal size: saiz dinilai tidak membesar oleh operator.');
    if(row.state==='dilated')parts.push('Dilated: diameter salur dinilai membesar oleh operator.');
   }else parts.push(row.state==='normal'?'Normal size dipilih oleh operator. Masukkan ukuran jika tersedia.':row.state==='dilated'?'Dilated dipilih oleh operator. Masukkan diameter jika boleh diukur.':'Belum diukur. Ruangan kosong tidak dianggap normal.');
   const conflict=site.key==='mpa'&&result.errors.some(e=>e.startsWith('Review main pulmonary artery'));
   if(conflict)parts.push('Pilihan saiz bercanggah dengan kategori diameter. Semak nilai atau pilih Measurement only untuk interpretasi berasingan.');
   feedback[site.key].closest('.artery-site').dataset.conflict=String(conflict);
   feedback[site.key].textContent=parts.join(' ');
  }
 }
 grid.addEventListener('input',refresh);grid.addEventListener('change',refresh);$('form').addEventListener('clinicalupdate',refresh);
 const restore=restoreStudy;restoreStudy=function(record){restore(record);refresh();
  const paEntered=GreatArteries.sites.filter(s=>s.group==='pa').some(s=>v(s.id)||v(s.id+'State'));
  const aortaEntered=GreatArteries.sites.filter(s=>s.group==='aorta').some(s=>v(s.id)||v(s.id+'State'));
  show(paEntered&&!aortaEntered?'pa':'aorta');
  for(const key of Object.keys(panels))panels[key].querySelector('.artery-extra').open=GreatArteries.sites.filter(s=>s.group===key&&s.extra).some(s=>v(s.id)||v(s.id+'State'))||(key==='aorta'&&!!v('gaAscendingDistance'));
 };
 refresh();
})();

;
/* measurement-editor.js */
/* Display inputs convert to canonical fields; calculations, OCR and old backups stay compatible. */
(function(){
 'use strict';
 const U=MeasurementUnits,form=$('form'),groups=new Map(),records=[];let editing=null;
 const strip=(text,unit)=>text.replace(' ('+unit+')','').replace('('+unit+')','').trim();
 function unitFor(id){const first=groups.get(id)?.[0];return first?.unitSelect?.value&&U.allowed(id,first.unitSelect.value)?first.unitSelect.value:U.fields[id]?.base;}
 function syncRecord(item,force=false){
  const {source,display,id,unitSelect}=item,spec=U.fields[id];
  let unit=unitFor(id);if(unitSelect&&unitSelect.value!==unit)unitSelect.value=unit;
  const canonical=$(id),value=canonical?.value||'';
  if(source!==canonical&&source.value!==value)source.value=value;
  const key=value+'|'+unit+'|'+source.disabled;
  if(!force&&key===item.last)return;item.last=key;
  if(editing!==item)display.value=U.format(U.convert(value,spec.base,unit));
  display.disabled=source.disabled;
  for(const key of ['min','max']){const bound=source[key];if(bound!==undefined&&bound!=='')display[key]=U.format(U.convert(bound,spec.base,unit));}
  display.required=source.required;display.readOnly=false;
 }
 function sync(){records.forEach(item=>syncRecord(item));}
 function setUnit(id,unit){
  if(!U.allowed(id,unit))return;
  const mass=id.match(/^(lvMass|mass[123])(?:Length|Width|Depth)$/),ids=mass?['Length','Width','Depth'].map(k=>mass[1]+k):[id];
  for(const key of ids){for(const item of groups.get(key)||[])if(item.unitSelect)item.unitSelect.value=unit;for(const item of groups.get(key)||[])syncRecord(item,true);}
 }
 function enhance(source,id){
  const spec=U.fields[id],label=source.closest('.field');if(!spec||!label)return;
  const same=groups.get(id)||[],index=same.length,caption=strip(label.firstChild?.textContent||id,spec.base);
  if(label.firstChild?.nodeType===3)label.firstChild.textContent=caption;
  const row=document.createElement('span');row.className='measurement-row';
  const display=document.createElement('input');display.type='number';display.step='any';display.inputMode='decimal';display.placeholder='—';display.id=id+'-entry'+(index?'-'+index:'');display.dataset.measurementControl='display';display.setAttribute('aria-label',caption);if(source.getAttribute('aria-describedby'))display.setAttribute('aria-describedby',source.getAttribute('aria-describedby'));
  row.append(display);let unitSelect=null;
  if(spec.options.length>1){unitSelect=document.createElement('select');unitSelect.id='unit-'+id+(index?'-'+index:'');unitSelect.dataset.measurementControl='unit';unitSelect.setAttribute('aria-label','Unit for '+caption);for(const unit of spec.options){const op=document.createElement('option');op.value=unit;op.textContent=unit;unitSelect.append(op);}row.append(unitSelect);}
  else{const badge=document.createElement('span');badge.className='measurement-unit';badge.textContent=spec.base;row.append(badge);}
  source.hidden=true;source.readOnly=true;source.classList.add('measurement-canonical');source.setAttribute('aria-hidden','true');label.setAttribute('for',display.id);source.after(row);
  const item={id,source,display,unitSelect,last:null};same.push(item);groups.set(id,same);records.push(item);
  for(const type of ['input','change'])display.addEventListener(type,event=>{event.stopPropagation();editing=item;source.value=U.format(U.convert(display.value,unitFor(id),spec.base));source.dispatchEvent(new Event(type,{bubbles:true}));editing=null;sync();});
  if(unitSelect)unitSelect.addEventListener('change',()=>{setUnit(id,unitSelect.value);});
  source.addEventListener('input',()=>{for(const record of groups.get(id)||[])syncRecord(record,true);});
  syncRecord(item,true);
 }
 for(const id of Object.keys(U.fields)){const source=$(id);if(source?.type==='number')enhance(source,id);}
 for(const source of form.querySelectorAll('input[data-shared]'))if(source.type==='number')enhance(source,source.dataset.shared);
 U.unit=unitFor;U.choose=setUnit;U.sync=sync;
 U.preferences=()=>Object.fromEntries([...groups.keys()].filter(id=>unitFor(id)!==U.fields[id].base).map(id=>[id,unitFor(id)]));
 U.focus=(id,options)=>{const target=(groups.get(id)||[]).find(item=>!item.display.closest('[hidden]'));if(target&&!target.display.disabled)target.display.focus(options);};
 const restore=restoreStudy;restoreStudy=function(record){
  for(const id of groups.keys())setUnit(id,U.fields[id].base);
  restore(record);
  for(const [id,unit]of Object.entries(record.measurementUnits||{}))if(U.allowed(id,unit))setUnit(id,unit);
  records.forEach(item=>syncRecord(item,true));form.dispatchEvent(new Event('clinicalupdate'));
 };
 const hint=document.createElement('p');hint.className='hint unit-intro';hint.textContent='Choose a compatible unit beside each value. Switching units converts the value without changing the measurement. Reports use standard clinical units; mass dimensions retain your cm/mm choice. Ratios and percentages keep their own units.';$('sections').before(hint);
 form.addEventListener('clinicalupdate',sync);
 sync();
})();

