  return {...a,avg:numericActive('quickRelax')&&ev.epSite==='average'?ev.ep:null,ee:numericActive('quickEe')?ev.ee:null,eeSite:ev.eeSite,ea:numericActive('quickEa')?ev.ea:null};
 };
 diastolicMeasurements=function(){const q=quickInput(),ev=evidence(),c=calculate(),d=diaData();const entries=[['Average e′',numericActive('quickRelax')&&ev.epSite==='average'?ev.ep:null,'cm/s'],['LAVI',numericActive('quickLavi')?c.lavi:null,'mL/m²'],['LARS',numericActive('quickLars')?raw('lars'):null,'%'],['Pulmonary vein S/D',numericActive('quickPv')?ev.sd:null,''],['IVRT',numericActive('quickIvrt')?raw('ivrt'):null,'ms'],['Reported PASP',numericActive('quickPressure')&&!(v('rapReliable')==='yes'&&positive(c.pasp))?raw('paspDirect'):null,'mmHg'],['Deceleration time',n('dt'),'ms'],['Septal a′',n('septA'),'cm/s'],['Lateral a′',n('latA'),'cm/s'],['PR end-diastolic velocity',d.prVel,'m/s'],['Mitral L wave',d.lwave,'cm/s'],['Pulmonary Ar−A duration',d.arDiff,'ms'],['E/A fall during Valsalva',d.valsalvaDrop,'%']];return entries.filter(x=>present(x[1])).map(([label,value,unit])=>label+' '+r(value)+(unit?' '+unit:'')+'.').join(' ');};
 function show(id,visible){$(id).closest('.field').hidden=!visible;}
 function refreshQuick(){
  const q=quickInput(),answered=!!q.context,eligible=q.context==='general'&&!q.excluded,ev=evidence(),a=diastolicAssessment();
  gateNote.textContent=!answered?'Select the study population first.':!eligible?'Standard ASE general diastolic grading may not apply. Use a condition-specific assessment and manual interpretation.':'General adult resting sinus-rhythm pathway.';
  quick.hidden=!eligible;manual.hidden=!answered;
  quick.querySelectorAll('input,select,textarea,button').forEach(el=>el.disabled=!eligible);
  mirrors.forEach(({src,x})=>{if(document.activeElement!==x)x.value=src.value;});
  rows.forEach(row=>{const value=v(row.id),active=numericActive(row.id);row.buttons.querySelectorAll('button').forEach(b=>b.setAttribute('aria-pressed',String(value===b.dataset.value)));row.values.hidden=!(row.expanded||value==='yes'||row.id==='quickEa'&&active);row.toggle.hidden=value==='yes';row.toggle.setAttribute('aria-expanded',String(!row.values.hidden));const key=keys[row.id];const conflict=ev.conflicts.includes(key);row.group.dataset.conflict=String(conflict);const measured=ev.measured[key];row.message.textContent=conflict?'Value does not match this selection. Review the value or Yes / No choice.':measured===null?'Optional: enter the measured value for the report.':'Measurement recorded.';if(conflict)row.values.hidden=false;});
  show('sept',['pair','septal'].includes(v('quickRelaxSource')));show('lat',['pair','lateral'].includes(v('quickRelaxSource')));show('quickAvgE',v('quickRelaxSource')==='average');
  show('e',v('quickEeMethod')==='calculated');show('quickEeSite',v('quickEeMethod')==='direct');show('quickEeValue',v('quickEeMethod')==='direct');
  show('quickEaValue',v('quickEaMethod')==='direct');show('a',v('quickEaMethod')==='inflow');show('fused',v('quickEaMethod')==='inflow');show('fusionReliable',v('quickEaMethod')==='inflow'&&v('fused')==='Partial fusion');ea.querySelector('[data-shared="e"]').closest('.field').hidden=v('quickEaMethod')!=='inflow';
  show('laReliable',true);show('pvReliable',true);
  show('pvs',v('quickPvMethod')==='velocities');show('pvd',v('quickPvMethod')==='velocities');show('quickPvValue',v('quickPvMethod')==='ratio');
  const needsEa=a.lap==='elevated'||q.relax==='yes'&&q.ee==='no'&&q.pressure==='no';if(needsEa)eaPanel.open=true;
  $('quickDiagnosis').textContent=a.grade===0?'Normal diastolic function with normal LAP.':a.grade?'Grade '+['','I','II','III'][a.grade]+' diastolic dysfunction with '+(a.lap==='normal'?'normal':'elevated')+' LAP.':a.lap?'Estimated LAP '+a.lap+'; grade indeterminate.':'Indeterminate — additional assessment required.';
  trNotice.hidden=q.pressure!=='na';trNotice.textContent='TR/PASP unavailable is recorded as N/A. Use reliable LARS, LAVI, PV S/D or IVRT to complete the assessment when possible; no TR is not a normal pressure result.';
  $('quickReason').textContent=a.reason+(v('diastolic')?' Manual interpretation will be used in the report.':'');if(a.additional)extra.open=true;
  const eeRow=rows.find(x=>x.id==='quickEe');if(!ev.conflicts.includes('ee')&&present(ev.ee))eeRow.message.textContent=(ev.eeSite[0].toUpperCase()+ev.eeSite.slice(1))+' E/e′ '+r(ev.ee)+(ev.eeCalculated?' · calculated from E and e′.':'.');
  const epRow=rows[0];if(!ev.conflicts.includes('relax')&&present(ev.ep))epRow.message.textContent=(ev.epSite[0].toUpperCase()+ev.epSite.slice(1))+' e′ '+r(ev.ep)+' cm/s.';
  quick.querySelectorAll('input,select,textarea').forEach(el=>{if(el.closest('[hidden]'))el.disabled=true;});
  const available=[];for(const [key,label,value]of [['relax','e′',ev.ep],['ee','E/e′',ev.ee],['ea','E/A',ev.ea],['lavi','LAVI',calculate().lavi],['lars','LARS',raw('lars')],['pv','PV S/D',ev.sd],['ivrt','IVRT',raw('ivrt')]])if(present(value))available.push(label+' '+r(value)+(['na','fusion'].includes(q[key])?' (excluded)':ev.conflicts.includes(key)?' (conflict)':numericActive(Object.keys(keys).find(id=>keys[id]===key))?' (used)':' (not confirmed)'));
  dataReview.textContent=(positive(raw('sept'))!==positive(raw('lat'))&&!present(ev.ep)?'Only one e′ site is entered. Select that TDI site or enter both sites. ':'')+(available.length?'Entered: '+available.join(' · ')+'. ':'')+(positive(calculate().lavi)&&v('laReliable')!=='yes'?'LAVI is not used until reliability and applicability are confirmed. ':'')+(present(ev.sd)&&v('pvReliable')!=='yes'?'PV S/D is not used until reliability and applicability are confirmed. ':'')+(positive(calculate().trpg)&&v('pressureReliable')!=='yes'?'Confirm TR/PASP signal reliability to use pulmonary pressure.':'');
  confirmLavi.hidden=!eligible||!positive(calculate().lavi)||v('laReliable')==='yes';confirmPv.hidden=!eligible||!present(ev.sd)||v('pvReliable')==='yes';
  confirmTr.hidden=!eligible||!positive(n('tr'))&&!positive(n('trGradient'))||!['No measurable TR jet','Inadequate envelope'].includes(v('notr'))&&v('pressureReliable')==='yes';
  useMeasurements.hidden=!eligible||!available.length;reviewInterpretation.hidden=a.grade!==null;updateDiastolic();
 }
 $('quickContext').addEventListener('change',()=>{$('specialConditions').value='';$('scope').value=v('quickContext')==='general'?'general':'other';$('signals').value='yes';if(v('quickContext')==='general'&&!v('rhythm'))$('rhythm').value='Sinus rhythm';refreshQuick();});
 $('form').addEventListener('clinicalupdate',refreshQuick);$('notr').addEventListener('change',()=>{refreshQuick();changed();});
 window.quickFindingErrors=function(){const errors=[];if(v('quickContext')!=='general')return errors;for(const id of numericIds){const el=$(id);if(!el.disabled&&v(id)&&(!Number.isFinite(n(id))||n(id)<=0))errors.push('Enter a positive value for '+el.closest('.field').firstChild.textContent+'.');}return errors;};
 window.diastolicReportNeedsRefresh=function(record){const assessed=diastolicAssessment();return !v('diastolic')&&assessed.grade!==null&&Array.isArray(record.report)&&record.report.some(x=>/diastolic (?:function|grade).*indeterminate/i.test(x.text||''));};
 const restore=restoreStudy;restoreStudy=function(record){$('diaEntryMode').value='quick';restore(record);const old=record.fields||{};if(old.diaEntryMode==='measurements'){const d=measuredData(),a=assessDiastolic(d);$('quickContext').value=old.quickContext||(d.scope==='general'?'general':'special');['quickRelax','quickEe','quickPressure'].forEach((id,i)=>$(id).value=a.primary[i]===null?'na':a.primary[i]?'yes':'no');$('quickEeMethod').value='calculated';$('quickEaMethod').value='inflow';$('quickRelaxSource').value=positive(d.sept)&&positive(d.lat)?'pair':d.tdiSource;for(const [id,val,cut]of [['quickLars',d.lars,18],['quickLavi',d.laReliable?d.lavi:null,34],['quickPv',d.pvReliable?d.sd:null,.67],['quickIvrt',d.ivrt,70]])$(id).value=present(val)?(id==='quickLavi'?val>cut:val<=cut)?'yes':'no':'';if(present(a.ea))$('quickEa').value=a.ea<=.8?'low':a.ea>=2?'high':'middle';}
  for(const row of rows)if(!Object.prototype.hasOwnProperty.call(old,row.id+'Origin'))$(row.id+'Origin').value=old.diaEntryMode==='measurements'||!old[row.id]?'auto':'manual';
  $('diaEntryMode').value='quick';rows.forEach(row=>row.expanded=numericActive(row.id));refreshQuick();if(diastolicReportNeedsRefresh(record)){dirty=true;$('status').textContent='Stored report needs regeneration: diastolic measurements are now linked.';['copy','print','download'].forEach(id=>$(id).disabled=true);}};
 refreshQuick();
})();

;
/* term-guide.js */
/* Short, original teaching notes. Definitions follow ASE reporting terminology (2025). */
(function(root){
 const terms={
 'Normal leaflet morphology':['Leaflet kelihatan tanpa perubahan struktur yang jelas dalam view yang diperoleh. Fungsi Doppler perlu dinilai berasingan.','The mitral leaflets appear structurally normal.'],
 'Normal cusp morphology':['Cusp kelihatan tanpa perubahan struktur yang jelas.','The pulmonary cusps appear structurally normal.'],
 'Trileaflet aortic valve':['Injap aorta mempunyai tiga cusp yang dikenal pasti.','A trileaflet aortic valve is seen.'],
 'Bicuspid aortic valve':['Injap aorta mempunyai dua cusp fungsional. Sahkan pada view yang sesuai.','A bicuspid aortic valve is seen.'],
 'Mitral annular calcification':['Kalsifikasi pada annulus mitral; bukan semestinya leaflet itu sendiri.','Mitral annular calcification is seen.'],
 'Annular dilatation':['Gelang sokongan injap melebar. Nilai bersama leaflet coaptation dan jet.','Tricuspid annular dilatation is seen.'],
 'Poorly visualized':['Struktur tidak dapat dilihat dengan jelas. Jangan label normal jika penilaian tidak mencukupi.','The valve leaflets are poorly visualized.'],
 'Regurgitant jet':['Aliran balik melalui injap pada fasa injap sepatutnya menutup.','A mitral regurgitant jet is recorded with CW Doppler.'],
 'Forward flow / stenotic jet':['Aliran ke hadapan melalui bukaan injap; velocity tinggi perlu dinilai bersama gradient, flow dan anatomy.','Forward aortic valve flow is recorded with CW Doppler.'],

 'Irregular':['Bentuk luar tidak sekata.','An irregular mass is seen at the LV apex.'],
 'Lobulated':['Ada beberapa bonjolan atau lobul pada bentuk luar.','A lobulated mass is attached to the mitral leaflet.'],
 'Round':['Bentuk hampir bulat.','A round mass measures 8 × 8 mm.'],
 'Oval':['Bentuk bujur; satu paksi lebih panjang.','An oval mass measures 12 × 6 mm.'],
 'Filamentous':['Nipis dan memanjang seperti benang.','A thin filamentous mass is seen on the valve.'],
 'Serpiginous':['Memanjang dan berliku seperti ular.','A serpiginous mobile mass is seen in the right atrium.'],
 'Laminated mural':['Lapisan mass yang mendatar di sepanjang dinding dalam jantung.','A laminated mural mass is seen along the apical endocardium.'],
 'Protruding':['Mass menonjol dari dinding ke dalam rongga jantung.','A protruding mass is seen at the LV apex.'],
 'Smooth surface':['Permukaan kelihatan rata dan sekata.','The mass has a smooth surface.'],
 'Irregular surface':['Permukaan tidak rata atau berlekuk.','The mass has an irregular surface.'],
 'Villous / frond-like surface':['Permukaan berjumbai halus seperti pelepah.','The mass has a frond-like surface.'],
 'Echogenic':['Kelihatan cerah kerana memantulkan banyak ultrasound. Kecerahan sahaja tidak menentukan jenis atau usia thrombus.','An echogenic mass is seen at the LV apex.'],
 'Hypoechoic':['Kelihatan lebih gelap berbanding tisu sekeliling.','A hypoechoic mass is seen within the LV apex.'],
 'Isoechoic':['Kecerahan hampir sama dengan tisu rujukan di sekeliling.','The mass is isoechoic to the adjacent myocardium.'],
 'Homogeneous':['Corak dalaman seragam di seluruh mass. Ini tekstur, bukan bentuk luar.','The mass has a homogeneous internal appearance.'],
 'Heterogeneous':['Corak dalaman bercampur: ada kawasan cerah dan gelap.','The mass has a heterogeneous internal appearance.'],
 'Calcified appearance':['Sangat cerah, kadangkala dengan bayang akustik. Nyatakan sebagai rupa imej.','The mass has a calcified appearance with acoustic shadowing.'],
 'Non-mobile':['Tiada pergerakan bebas yang jelas berbanding tapak lekatan.','The mass is non-mobile and broad-based.'],
 'Mobile':['Sebahagian atau seluruh mass bergerak bebas daripada dinding atau leaflet.','A mobile mass is attached to the leaflet.'],
 'Highly mobile':['Pergerakan bebas yang ketara. Perlu dilihat pada cine, bukan satu gambar statik.','A highly mobile mass projects into the cavity.'],
 'Independent oscillating motion':['Berayun sendiri, berbeza daripada gerakan leaflet atau dinding.','The mass shows independent oscillating motion.'],
 'Broad-based attachment':['Tapak lekatan lebar pada dinding atau leaflet. Nilai mobility secara berasingan.','A broad-based mass is attached to the apical wall.'],
 'Pedunculated attachment':['Mass melekat melalui tangkai.','A pedunculated mass is attached by a stalk.'],
 'Narrow stalk':['Tangkai lekatan yang halus atau sempit.','The mass is attached by a narrow stalk.'],
 'Attachment not clearly seen':['Tapak lekatan tidak dapat dikenal pasti dengan yakin. Jangan andaikan lokasinya.','The attachment site is not clearly seen.'],
 'Smoke-like swirling echoes':['SEC: echo seperti asap yang berputar dalam darah. SEC bukan mass atau thrombus diskret.','Spontaneous echo contrast is seen in the LV cavity.'],
 'Dense swirling echoes':['SEC yang ketara pada cine; jangan samakan dengan thrombus berlekatan.','Dense spontaneous echo contrast is seen in the LV apex.'],
 'Prolapse':['Leaflet membonjol melepasi aras annulus ke ruang sebelah semasa penutupan.','Posterior mitral leaflet prolapse is seen.'],
 'Flail':['Hujung leaflet kehilangan sokongan dan terbalik ke ruang sebelah.','A flail posterior mitral leaflet is seen.'],
 'Thickened':['Leaflet atau cusp kelihatan menebal. Nyatakan motion dan fungsi secara berasingan.','The mitral leaflets are thickened.'],
 'Calcified':['Kelihatan deposit sangat cerah pada leaflet/cusp atau annulus.','The aortic cusps are calcified with restricted opening.'],
 'Restricted':['Pergerakan leaflet atau pembukaan cusp berkurang.','Restricted aortic cusp opening is seen.'],
 'Tethering':['Leaflet ditarik ke arah ventrikel oleh struktur sokongan.','Mitral leaflet tethering is seen.'],
 'Coaptation':['Coaptation ialah pertemuan tepi leaflet ketika menutup. Tidak lengkap boleh meninggalkan jurang.','Incomplete leaflet coaptation is seen.'],
 'Commissural fusion':['Tepi pertemuan dua leaflet bercantum, mengehadkan pembukaan.','Commissural fusion is seen.'],
 'Doming':['Leaflet melengkung seperti kubah semasa membuka.','Diastolic doming of the anterior mitral leaflet is seen.'],
 'Primary / structural':['Kebocoran berpunca daripada perubahan struktur injap itu sendiri.','Primary mitral regurgitation associated with leaflet prolapse.'],
 'Secondary / functional':['Kebocoran berkaitan perubahan geometri ventrikel/atrium atau annulus.','Secondary mitral regurgitation with leaflet tethering.'],
 'Mixed mechanism':['Lebih daripada satu mekanisme menyumbang kepada kebocoran.','Mixed primary and secondary mitral regurgitation.'],
 'Paravalvular leak':['Aliran bocor di sekitar gelang prostesis, bukan melalui bukaan injap.','A paravalvular regurgitant jet is seen.'],
 'Central':['Jet melalui bahagian tengah bukaan injap.','A central regurgitant jet is seen.'],
 'Eccentric':['Jet tidak di tengah; boleh menghala atau melekat pada dinding. Luas jet sahaja boleh mengelirukan.','An eccentric regurgitant jet is directed along the atrial wall.'],
 'Anteriorly directed':['Jet menghala ke bahagian anterior.','An anteriorly directed mitral regurgitant jet is seen.'],
 'Posteriorly directed':['Jet menghala ke bahagian posterior.','A posteriorly directed mitral regurgitant jet is seen.'],
 'Multiple jets':['Lebih daripada satu jet berasingan.','Multiple regurgitant jets are seen.'],
 'Holosystolic':['Jet berterusan sepanjang sistol.','Holosystolic mitral regurgitation is seen.'],
 'Holodiastolic':['Jet berterusan sepanjang diastol.','Holodiastolic aortic regurgitation is seen.'],
 'Early systolic':['Jet terutama pada awal sistol.','Early systolic regurgitation is seen.'],
 'Late systolic':['Jet terutama pada akhir sistol.','Late systolic mitral regurgitation is seen.'],
 'Early diastolic':['Jet terutama pada awal diastol.','Early diastolic regurgitation is seen.'],
 'Faint':['Signal CW kurang padat. Gain dan penjajaran boleh mempengaruhi rupa signal.','The CW regurgitant signal is faint.'],
 'Moderately dense':['Signal CW sederhana padat. Nilai bersama parameter lain.','The CW signal is moderately dense.'],
 'Dense':['Signal CW padat; ketumpatan sahaja tidak menetapkan severity.','A dense CW regurgitant signal is recorded.'],
 'Parabolic':['Envelope melengkung dengan kenaikan dan penurunan yang lebih beransur.','A parabolic CW envelope is recorded.'],
 'Triangular':['Envelope berbentuk segi tiga dengan puncak dan penurunan lebih cepat.','A triangular CW regurgitant envelope is recorded.'],
 'Early-peaking':['Kelajuan maksimum dicapai lebih awal dalam tempoh aliran.','An early-peaking systolic envelope is recorded.'],
 'Late-peaking':['Kelajuan maksimum dicapai lewat dalam tempoh aliran.','A late-peaking systolic envelope is recorded.'],
 'Rounded':['Puncak envelope bulat, bukan tajam.','The CW envelope has a rounded peak.'],
 'Rapid deceleration':['Kelajuan jatuh dengan cepat selepas puncak.','Rapid deceleration of the diastolic jet is seen.'],
 'Incomplete envelope':['Sebahagian envelope tidak jelas. Jangan anggap nilai puncaknya lengkap atau normal.','The CW envelope is incomplete; peak velocity is unreliable.'],
 'Systolic flow reversal':['Aliran vena berbalik semasa sistol. Perlu acquisition yang betul dan interpretasi konteks.','Systolic flow reversal is seen in the sampled vein.'],
 'Systolic blunting':['Komponen aliran ke hadapan semasa sistol berkurang.','Systolic blunting is seen in the sampled vein.'],
 'Holodiastolic flow reversal':['Aliran berbalik sepanjang diastol; nyatakan tapak dan kualiti signal.','Holodiastolic flow reversal is seen in the descending aorta.'],
 'Continuity equation':['Menggunakan prinsip isipadu aliran yang sama melalui dua lokasi. Perlu ukuran dan Doppler yang tepat.','Valve area is calculated by the continuity equation.'],
 '2D planimetry':['Jejak sempadan bukaan injap terus pada imej 2D di aras yang betul.','Mitral valve area is measured by 2D planimetry.'],
 '3D planimetry':['Jejak bukaan injap pada satah 3D yang dijajarkan dengan orifis.','Valve area is measured by 3D planimetry.'],
 'Pressure half-time':['Masa untuk gradient tekanan berkurang separuh. Dipengaruhi keadaan loading dan compliance.','The mitral pressure half-time is 160 ms.']
 };
 function lookup(value){if(terms[value])return {meaning:terms[value][0],example:terms[value][1]};const match=Object.keys(terms).sort((a,b)=>b.length-a.length).find(k=>String(value).toLowerCase().includes(k.toLowerCase()));return match?{meaning:terms[match][0],example:terms[match][1]}:null;}
 function attach(input,topic='Pilih istilah untuk lihat maksud dan contoh.'){if(!input||!input.parentElement)return;const help=document.createElement('div');help.className='term-help';help.id=input.id?input.id+'Help':'';const meaning=document.createElement('p');help.append(meaning);input.after(help);if(help.id)input.setAttribute('aria-describedby',help.id);let last,example,phrase;
  function update(){if(last===input.value)return;last=input.value;const d=lookup(input.value);meaning.textContent=d?d.meaning:topic;if(d&&!example){example=document.createElement('details');const summary=document.createElement('summary');summary.textContent='Contoh ayat';phrase=document.createElement('p');example.append(summary,phrase);help.append(example);}if(example){example.hidden=!d;phrase.textContent=d?'Contoh: '+d.example:'';example.open=false;}}
  input.addEventListener('change',update);update();return update;
 }

 root.TermGuide={lookup,attach,terms};if(typeof module!=='undefined')module.exports={lookup,terms};
})(typeof window!=='undefined'?window:globalThis);

;
/* valve-editor.js */
(function(){
 function updateEF(){const visual=v('efMethod')==='visual';$('ef').parentElement.hidden=visual;for(const id of ['efLow','efHigh'])$(id).parentElement.hidden=!visual;$('efRangeNote').textContent=visual?'Report wording: LVEF visually estimated at the entered range. Use only when a defensible visual estimate is possible; poor windows alone do not justify an estimate.':'Report wording: LVEF by Simpson’s biplane method.';}
 const efNote=document.createElement('p');efNote.id='efRangeNote';efNote.className='wide hint';$('ef').parentElement.after(efNote);
 $('efLow').max=$('efHigh').max='100';$('efMethod').addEventListener('change',updateEF);$('form').addEventListener('clinicalupdate',updateEF);updateEF();
 const helpUpdates=[];
 const morph={
 mv:['Normal leaflet morphology','Thickened leaflets','Calcified leaflets','Mitral annular calcification','Anterior leaflet prolapse','Posterior leaflet prolapse','Bileaflet prolapse','Flail anterior leaflet','Flail posterior leaflet','Restricted leaflet motion','Leaflet tethering','Incomplete leaflet coaptation','Commissural fusion','Diastolic doming of the anterior leaflet','Poorly visualized leaflets'],
 av:['Trileaflet aortic valve','Bicuspid aortic valve','Thickened cusps','Calcified cusps','Restricted cusp opening','Cusp prolapse','Flail cusp','Incomplete cusp coaptation','Poorly visualized cusps'],
 tv:['Normal leaflet morphology','Thickened leaflets','Leaflet prolapse','Flail leaflet','Restricted leaflet motion','Leaflet tethering','Incomplete leaflet coaptation','Annular dilatation','Poorly visualized leaflets'],
 pv:['Normal cusp morphology','Thickened cusps','Restricted cusp opening','Systolic doming','Incomplete cusp coaptation','Poorly visualized cusps']};
 for(const id of ['mv','av','tv','pv']){
  const panel=document.createElement('details');panel.className='wide valve-builder';panel.innerHTML='<summary>Appearance & CW signal (optional)</summary>';const grid=document.createElement('div');grid.className='grid';panel.append(grid);$(id).parentElement.after(panel);
  const select=(key,label,options)=>{const f=field(id+key,label,'select',[['','Not selected'],...options]);grid.append(f);if(typeof TermGuide!=='undefined'){const update=TermGuide.attach($(id+key));if(update)helpUpdates.push(update);}return $(id+key);};
  const anatomy=select('Morph','Valve morphology',morph[id]);
  const add=document.createElement('button');add.type='button';add.textContent='Add morphology';grid.append(add);
  const append=text=>{if(!text)return;if(v(id)===normalText[id]&&!/^Normal/.test(text)){if(!confirm('Replace the existing normal valve statement with this finding?'))return;$(id).value='';}const old=ReportCore.polishValve(v(id));if(!old.includes(text))$(id).value=[old,text].filter(Boolean).join(' ');changed();preview();};
  add.onclick=()=>{if(!anatomy.value)return;append(anatomy.value+'.');anatomy.value='';};
  const cwPanel=document.createElement('details');cwPanel.className='wide valve-cw';cwPanel.innerHTML='<summary>CW Doppler description (optional)</summary>';const cwGrid=document.createElement('div');cwGrid.className='grid';cwPanel.append(cwGrid);panel.append(cwPanel);
  const jet=select('CwJet','CW Doppler signal',[['regurgitation','Regurgitant jet'],['forward','Forward flow / stenotic jet']]);
  const density=select('CwDensity','Signal density',['Faint','Moderately dense','Dense']);
  const contour=select('CwContour','Envelope / contour',['Parabolic','Triangular','Early-peaking','Late-peaking','Rounded','Rapid deceleration','Incomplete envelope']);
  const timing=select('CwTiming','Timing',[]);
  function updateTiming(){const reg=jet.value==='regurgitation',systolic=['mv','tv'].includes(id);const options=reg?(systolic?['Holosystolic','Early systolic','Late systolic']:['Holodiastolic','Early diastolic']):(['av','pv'].includes(id)?['Systolic']:['Diastolic']);timing.replaceChildren();for(const value of ['',...options]){const op=document.createElement('option');op.value=value;op.textContent=value||'Not selected';timing.append(op);}}
  jet.onchange=()=>{updateTiming();helpUpdates.forEach(fn=>fn());};updateTiming();
  for(const input of [jet,density,contour,timing])cwGrid.append(input.closest('.field'));
  const cw=document.createElement('button');cw.type='button';cw.textContent='Add CW Doppler description';cwGrid.append(cw);cw.onclick=()=>{if(!jet.value||![density,contour,timing].some(x=>x.value)){toast('Select the CW signal and at least one characteristic.');return;}append('CW Doppler of '+(jet.value==='regurgitation'?'the regurgitant jet':'forward flow')+' shows '+[density.value,timing.value,contour.value].filter(Boolean).map(x=>x.toLowerCase()).join(', ')+' signal characteristics.');};
  const hint=document.createElement('p');hint.className='hint';hint.textContent='CW density, contour and timing describe the signal. Assign severity after integrated valve assessment. Edit inserted phrases in the findings box.';panel.append(hint);
  const review=document.createElement('details');review.innerHTML='<summary>Cleaned report wording</summary>';const output=document.createElement('p');output.className='valve-wording';review.append(output);$(id).parentElement.append(review);function preview(){output.textContent=ReportCore.polishValve(v(id))||'Enter findings above.';}$(id).addEventListener('input',preview);review.addEventListener('toggle',preview);preview();
 }
 const note=document.createElement('p');note.className='wide hint';note.textContent='Valve text: basic spelling, sentence case and common grammar are cleaned when generating. Original entries remain editable. Complex wording is kept for review; values and severity are not reinterpreted.';note.hidden=true;$('mv').parentElement.before(note);
 const restore=restoreStudy;restoreStudy=function(record){restore(record);updateEF();helpUpdates.forEach(fn=>fn());};
})();

