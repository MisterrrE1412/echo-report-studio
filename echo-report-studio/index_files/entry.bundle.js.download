function usable(id){return !$(id+'Quality')||v(id+'Quality')==='auto';}
const sharedCalculate=calculate;
calculate=function(){const c=sharedCalculate();if(!usable('tr')||['No measurable TR jet','Inadequate envelope'].includes(v('notr')))c.trpg=null;if(!usable('rap'))c.rap=null;if(!usable('laviDirect'))c.lavi=usable('lavol')&&positive(n('lavol'))&&c.b?n('lavol')/c.b:null;else if(!positive(n('laviDirect'))&&!usable('lavol'))c.lavi=null;return c;};
const originalDiaData=diaData;
diaData=function(){const d=originalDiaData();if(v('specialConditions'))d.scope='special';
 for(const id of ['e','a','sept','lat','tr','lars','ivrt','prVel','lwave'])if(!usable(id))d[id]=null;
 if(v('fused')==='Partial fusion'&&v('fusionReliable')==='yes')d.fused='Separable';
 if(d.fused!=='Separable'){d.a=null;d.valsalvaDrop=null;}
 d.tdiSource=positive(d.sept)&&positive(d.lat)?'average':v('tdiSource');
 d.noTR=['No measurable TR jet','Inadequate envelope'].includes(v('notr'))||['unobtainable','unreliable'].includes(v('trQuality'));
 if(d.noTR||!usable('tr'))d.tr=null;
 d.rap=v('rapReliable')==='yes'&&usable('rap')?d.rap:null;
 d.paspDirect=usable('paspDirect')?n('paspDirect'):null;
