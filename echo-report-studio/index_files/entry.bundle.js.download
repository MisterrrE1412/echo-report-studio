/* lesion-editor.js */
(function(){
 const valves=[['mv','Mitral','Inflow to LV'],['av','Aortic','Outflow from LV'],['tv','Tricuspid','Inflow to RV'],['pv','Pulmonary','Outflow from RV']];
 const records=[],helpRefresh=[];
 const add=(parent,id,label,type='select',options)=>{parent.append(field(id,label,type,options));return $(id);};
 const options=items=>[['','Not specified'],...items];
 function explain(input,topic){const update=TermGuide.attach(input,topic);if(update)helpRefresh.push(update);}
 function measured(parent,id,label,unit){const x=add(parent,id,label+(unit?' ('+unit+')':''),'number');x.min='0.001';return x;}
 function fold(parent,title,cls=''){const d=document.createElement('details');d.className='wide '+cls;const summary=document.createElement('summary');summary.textContent=title;const grid=document.createElement('div');grid.className='grid';d.append(summary,grid);parent.append(d);return {d,grid};}
 const valveRoot=$('mv').closest('.grid'),valveNav=document.createElement('nav');valveNav.className='valve-tabs wide';valveNav.setAttribute('aria-label','Choose a valve');valveRoot.prepend(valveNav);
 const intro=document.createElement('p');intro.className='wide valve-intro';intro.textContent='Pilih satu injap. Leak = regurgitation (kebocoran). Narrowing = stenosis (penyempitan). Ukuran lanjut dibuka hanya bila diperlukan.';valveNav.after(intro);
 let activeValve='mv';
 for(const [id,title,position]of valves){
  $(id).parentElement.querySelector('.valve-presets')?.remove();
  const card=document.createElement('details');card.id=id+'ValveCard';card.className='wide valve-card clinical-panel';card.dataset.valve=id;
  const heading=document.createElement('summary');heading.textContent=title+' valve';const badge=document.createElement('span');badge.className='lesion-summary';heading.append(badge);card.append(heading);
  const existing=$(id).closest('.field'),morphology=existing.nextElementSibling;existing.before(card);
  const top=document.createElement('div');top.className='valve-card-top';const positionText=document.createElement('span');positionText.textContent=position;top.append(positionText);card.append(top);
  const normal=existing.querySelector('.normal-button');normal.textContent='Normal valve';top.append(normal);
  const grid=document.createElement('div');grid.className='valve-lesion-grid';card.append(grid);
  const hidden=document.createElement('div');hidden.hidden=true;card.append(hidden);
  const lesionMap={};
  for(const [key,label,explanation]of [['reg','Leak · Regurgitation','Darah mengalir semula melalui injap yang sedang menutup.'],['sten','Narrowing · Stenosis','Bukaan injap sempit dan menghalang aliran ke hadapan.']]){
   const prefix=id+key,block=document.createElement('section');block.className='lesion-block '+key;grid.append(block);
   const state=field(prefix+'State','Stored lesion state','select',[['','Not assessed'],['none','None'],['present','Present']]),severity=field(prefix+'Severity','Stored severity','select',options([...(key==='reg'?['Trace']:[]),'Mild','Moderate','Severe','Indeterminate']));hidden.append(state,severity);
   const choice=document.createElement('label');choice.className='field';choice.append(document.createTextNode(label));const select=document.createElement('select');select.dataset.lesion=prefix;select.setAttribute('aria-label',title+' '+label);choice.append(select);block.append(choice);
   for(const [value,text]of [['','Not assessed'],['none','None'],['pending','Present — grade pending'],...(key==='reg'?[['Trace','Trace']]:[]),...['Mild','Moderate','Severe','Indeterminate'].map(x=>[x,x])]){const option=document.createElement('option');option.value=value;option.textContent=text;select.append(option);}
   const meaning=document.createElement('p');meaning.className='lesion-meaning';meaning.textContent=explanation;block.append(meaning);
   const detail=document.createElement('div');detail.className='lesion-detail';block.append(detail);
   const measures=fold(detail,'Add supporting details / measurements','lesion-measurements');
   if(key==='reg'){
    for(const [suffix,label,items]of [['Mechanism','Mechanism',['Primary / structural','Secondary / functional','Mixed mechanism','Paravalvular leak']],['Direction','Jet direction',['Central','Eccentric','Anteriorly directed','Posteriorly directed','Multiple jets']],['Timing','Jet timing',['mv','tv'].includes(id)?['Holosystolic regurgitation','Early systolic regurgitation','Late systolic regurgitation']:['Holodiastolic regurgitation','Early diastolic regurgitation']]])explain(add(measures.grid,prefix+suffix,label,'select',options(items)));
    const flow={mv:['Pulmonary vein systolic flow reversal','Pulmonary vein systolic blunting'],av:['Holodiastolic flow reversal in descending aorta','Holodiastolic flow reversal in abdominal aorta'],tv:['Hepatic vein systolic flow reversal','Hepatic vein systolic blunting'],pv:['Diastolic flow reversal in branch pulmonary arteries']}[id];explain(add(measures.grid,prefix+'Flow','Supporting flow finding','select',options(flow)));
   }
   const keys=key==='reg'?(['mv','av','tv'].includes(id)?['vc','eroa','rvol','rf',...(id==='av'?['pht']:[])]:['rf','pht']):({av:['vmax','peak','mean','area','dvi','svi'],mv:['mean','area','pht','hr'],tv:['mean','area','hr'],pv:['vmax','peak','mean']}[id]);
   for(const [k,label,unit]of ClinicalDetails.valveSpecs[key])if(keys.includes(k)){const x=measured(measures.grid,prefix+k,label,unit);if(k==='rf')x.max='100';}
   if(key==='sten'&&['mv','av','tv'].includes(id))explain(add(measures.grid,prefix+'AreaMethod','Valve area method','select',options(['Continuity equation','2D planimetry','3D planimetry',...(id==='mv'?['Pressure half-time']:[])])));
   const note=document.createElement('p');note.className='hint';note.textContent='Severity perlu gabungan morphology, Doppler dan ukuran. Satu nilai atau warna jet sahaja tidak menetapkan gred.';detail.append(note);
   select.addEventListener('change',()=>{const value=select.value;$(prefix+'State').value=value==='none'?'none':value?'present':'';$(prefix+'Severity').value=['none','pending',''].includes(value)?'':value;if(value&&value!=='none'&&v(id)===normalText[id])$(id).value='';if(id==='tv'&&key==='reg'&&value&&value!=='none'&&v('notr')==='No measurable TR jet')$('notr').value='';changed();refresh();});
   $(prefix+'State').addEventListener('change',()=>{if(v(prefix+'State')==='present'&&v(id)===normalText[id])$(id).value='';refresh();});
   lesionMap[key]={prefix,detail,keys,select,measures:measures.d};
  }
  if(morphology?.classList.contains('valve-builder'))card.append(morphology);
  const textFold=fold(card,'Free text / other valve findings','valve-free-text');textFold.grid.append(existing);existing.firstChild.textContent='Additional findings (editable report wording)';
  const preview=document.createElement('p');preview.className='structured-preview';preview.setAttribute('aria-live','polite');card.append(preview);
  normal.onclick=()=>{if((v(id)||Object.values(lesionMap).some(x=>v(x.prefix+'State')==='present'))&&!confirm('Replace this valve’s recorded findings with normal findings?'))return;$(id).value=normalText[id];for(const x of Object.values(lesionMap))card.querySelectorAll('input[id],select[id],textarea[id]').forEach(el=>{if(el.id.startsWith(x.prefix))el.value='';});for(const suffix of ['Morph','CwJet','CwDensity','CwContour','CwTiming'])if($(id+suffix))$(id+suffix).value='';for(const x of Object.values(lesionMap))$(x.prefix+'State').value='none';if(id==='tv')$('tvregState').value='';changed();refresh();};
  const tab=document.createElement('button');tab.type='button';tab.dataset.valve=id;tab.innerHTML='<strong>'+id.toUpperCase()+'</strong><span>'+title+'</span>';tab.setAttribute('aria-controls',card.id);tab.onclick=()=>{activeValve=id;card.open=true;refresh();};valveNav.append(tab);
  records.push({id,card,lesionMap,preview,textFold:textFold.d,tab});
 }
 function data(id){const result={};for(const key of ['reg','sten']){const pre=id+key,x={state:v(pre+'State'),severity:v(pre+'Severity')};for(const k of ['Mechanism','Direction','Timing','Flow'])x[k.toLowerCase()]=$(pre+k)?v(pre+k):'';for(const [k]of ClinicalDetails.valveSpecs[key])x[k]=$(pre+k)?n(pre+k):null;result[key]=x;}return result;}
 window.structuredValveReport=function(id,brief=false){if(v(id)===normalText[id]&&!['reg','sten'].some(k=>v(id+k+'State')==='present'))return '';let text=ClinicalDetails.valveText(id,data(id),brief);if(!brief&&v(id+'stenState')==='present'&&$(id+'stenAreaMethod')&&v(id+'stenAreaMethod')&&positive(n(id+'stenarea')))text+=' Valve area by '+v(id+'stenAreaMethod').toLowerCase()+'.';return text;};
 window.hasStructuredValve=id=>['reg','sten'].some(key=>v(id+key+'State')==='present');
 window.openValve=id=>{if(!records.some(x=>x.id===id))return;activeValve=id;records.find(x=>x.id===id).card.open=true;refresh();};
 let lastValve='';function refresh(){for(const item of records){const active=item.id===activeValve;item.card.hidden=!active;if(active&&lastValve!==activeValve)item.card.open=true;item.tab.setAttribute('aria-pressed',String(active));for(const x of Object.values(item.lesionMap)){const state=v(x.prefix+'State');x.detail.hidden=state!=='present';x.select.value=state==='none'?'none':state==='present'?v(x.prefix+'Severity')||'pending':'';}const text=[ReportCore.polishValve(v(item.id)),structuredValveReport(item.id)].filter(Boolean).join(' ');if(item.preview.textContent!==text)item.preview.textContent=text;item.preview.hidden=!text;item.card.querySelector('.lesion-summary').textContent=ClinicalDetails.valveText(item.id,data(item.id),true);item.tab.dataset.recorded=String(!!v(item.id)||!!structuredValveReport(item.id));}lastValve=activeValve;}
 // Shared mass fields are also available directly within the LV section.
 const masses=[];
 function buildMass(pre,parent,title,types,locations){
  const card=document.createElement('section');card.className='mass-entry';const heading=document.createElement('h4');heading.textContent=title;card.append(heading);parent.append(card);const grid=document.createElement('div');grid.className='grid';card.append(grid);
  add(grid,pre+'Type','Assessment','select',types);
  const detail=document.createElement('div');detail.className='grid wide';grid.append(detail);
  add(detail,pre+'Location','Location','select',options(locations));add(detail,pre+'Site','Specific wall / leaflet / attachment site','text');
  for(const key of ['Length','Width','Depth'])measured(detail,pre+key,key+(key==='Depth'?' (optional)':''),'mm');
  const appearance=fold(detail,'Describe appearance · shape, texture & attachment','mass-appearance');
  for(const [suffix,label,items,topic]of [
   ['Shape','Shape / pattern',['Irregular','Lobulated','Round','Oval','Filamentous','Serpiginous','Laminated mural','Protruding'],'Shape = bentuk luar mass; tidak menentukan diagnosis.'],
   ['Surface','Surface',['Smooth surface','Irregular surface','Villous / frond-like surface'],'Surface = rupa permukaan mass.'],
   ['Echo','Echo brightness',['Echogenic','Hypoechoic','Isoechoic','Calcified appearance','Homogeneous','Heterogeneous'],'Brightness = kecerahan imej berbanding tisu sekeliling.'],
   ['Texture','Internal texture',['Homogeneous','Heterogeneous'],'Texture = keseragaman corak di dalam mass.'],
   ['Mobility','Mobility',['Non-mobile','Mobile','Highly mobile','Independent oscillating motion'],'Lihat cine untuk nilai pergerakan, bukan satu gambar statik.'],
   ['Attachment','Attachment',['Broad-based attachment','Pedunculated attachment','Narrow stalk','Attachment not clearly seen'],'Attachment = cara mass melekat pada dinding atau leaflet.']
  ]){const input=add(appearance.grid,pre+suffix,label,'select',options(items));if(suffix==='Echo')input.querySelectorAll('option').forEach(op=>{if(['Homogeneous','Heterogeneous'].includes(op.value)){op.hidden=true;op.disabled=true;}});explain(input,topic);}
  add(detail,pre+'Notes','Associated findings / uncertainty','textarea');const preview=document.createElement('p');preview.className='structured-preview';preview.setAttribute('aria-live','polite');card.append(preview);
  const clear=document.createElement('button');clear.type='button';clear.className='quiet';clear.textContent='Clear this entry';clear.onclick=()=>{if(!confirm('Clear this structured mass entry?'))return;card.querySelectorAll('input,select,textarea').forEach(el=>el.value='');changed();refreshMass();};card.append(clear);
  const entry={pre,card,detail,preview,clear,appearance:appearance.d};masses.push(entry);return entry;
 }
 const lvPanel=document.createElement('details');lvPanel.className='wide clinical-panel lv-mass-panel';lvPanel.id='lvThrombusPanel';lvPanel.innerHTML='<summary>LV thrombus & spontaneous echo contrast (SEC)</summary><p class="hint">Thrombus ialah mass diskret. SEC ialah echo seperti asap dalam darah; kedua-duanya dinilai secara berasingan.</p>';$('lvnotes').closest('.field').before(lvPanel);$('lvnotes').closest('.field').firstChild.textContent='Other LV findings / comments';
 const lvMass=buildMass('lvMass',lvPanel,'LV thrombus / mass',[['','Not assessed'],['none','No LV thrombus seen'],['thrombus','Suspected LV thrombus'],['mass','LV mass — type uncertain'],['limited','Cannot exclude — limited apical views']],['LV apex','Apical aneurysm','LV anterior wall','LV septal wall','LV inferior wall','LV lateral wall','Other LV site']);
 const lvTip=document.createElement('p');lvTip.className='hint';lvTip.textContent='Semak mass sepanjang cardiac cycle dalam sekurang-kurangnya dua view berbeza. Jika apex tidak jelas, catat limitation dan bincang penilaian lanjut; jangan pilih “No thrombus” secara automatik.';lvPanel.append(lvTip);
 const secGrid=document.createElement('div');secGrid.className='grid';lvPanel.append(secGrid);add(secGrid,'lvSec','Spontaneous echo contrast (SEC)','select',[['','Not assessed'],['none','Not seen'],['present','Present'],['uncertain','Uncertain']]);
 const secDetail=document.createElement('div');secDetail.className='grid wide';secGrid.append(secDetail);add(secDetail,'lvSecLocation','SEC location','select',options(['LV cavity','LV apex','Apical aneurysm']));explain(add(secDetail,'lvSecAppearance','SEC appearance','select',options(['Smoke-like swirling echoes','Dense swirling echoes'])),'SEC ialah echo seperti asap, bukan thrombus diskret.');
 const massPanel=document.createElement('details');massPanel.className='wide clinical-panel mass-panel';massPanel.id='otherMassPanel';massPanel.innerHTML='<summary>Vegetation / thrombus / other mass</summary><p class="hint">Untuk LV thrombus, gunakan panel dalam bahagian LV. Ruang ini untuk mass lain atau mass tambahan. Jenis mass kekal sebagai clinical impression.</p>';$('veg').closest('.field').before(massPanel);
 for(let i=1;i<=3;i++)buildMass('mass'+i,massPanel,'Mass '+i,[['','No structured entry'],['vegetation','Suspected vegetation'],['thrombus','Suspected thrombus'],['mass','Mass — type uncertain']],['LV apex','LV wall','Left atrium','Left atrial appendage','Right atrium','Right ventricle','Mitral valve','Aortic valve','Tricuspid valve','Pulmonary valve','Prosthetic valve','Device lead','Interatrial septum','Other site']);
 const more=document.createElement('button');more.type='button';more.textContent='Add another mass';massPanel.append(more);let visibleMasses=1;more.onclick=()=>{visibleMasses=Math.min(3,visibleMasses+1);refreshMass();};
 function massData(pre){const m={};for(const key of ['Type','Location','Site','Shape','Surface','Echo','Texture','Mobility','Attachment','Notes'])m[key.toLowerCase()]=v(pre+key);for(const key of ['Length','Width','Depth'])m[key.toLowerCase()]=n(pre+key);m.unit=typeof MeasurementUnits!=='undefined'&&MeasurementUnits.unit?MeasurementUnits.unit(pre+'Length'):'mm';return m;}
 const other=()=>masses.filter(x=>x.pre!=='lvMass');
 window.structuredMassReport=()=>other().map(x=>ClinicalDetails.massText(massData(x.pre))).filter(Boolean).join(' ');
 window.structuredMassConclusion=()=>other().filter(x=>v(x.pre+'Type')).map(x=>{const m=massData(x.pre);return ClinicalDetails.massText({type:m.type,location:m.location,length:m.length,width:m.width,depth:m.depth,unit:m.unit});}).join(' ');
 window.structuredLVReport=function(brief=false){const m=massData('lvMass');const parts=[m.type==='none'?'No LV thrombus seen in the visualized segments.':m.type==='limited'?'LV thrombus cannot be excluded due to limited apical views.':ClinicalDetails.massText(brief?{type:m.type,location:m.location,length:m.length,width:m.width,depth:m.depth,unit:m.unit}:m)];if(v('lvSec')==='present')parts.push((v('lvSecAppearance')==='Dense swirling echoes'?'Dense spontaneous echo contrast seen':'Spontaneous echo contrast seen')+(v('lvSecLocation')?' in the '+v('lvSecLocation'):'')+'.');else if(v('lvSec')==='none')parts.push('No LV spontaneous echo contrast seen.');else if(v('lvSec')==='uncertain')parts.push('Possible LV spontaneous echo contrast.');return parts.filter(Boolean).join(' ');};
 function refreshMass(){masses.forEach(x=>{const type=v(x.pre+'Type'),isLV=x.pre==='lvMass';if(!isLV)x.card.hidden=Number(x.pre.slice(4))>visibleMasses&&!type;x.detail.hidden=!['vegetation','thrombus','mass'].includes(type);x.clear.hidden=!type;const text=isLV?structuredLVReport():ClinicalDetails.massText(massData(x.pre));if(x.preview.textContent!==text)x.preview.textContent=text;x.preview.hidden=!text;});secDetail.hidden=v('lvSec')!=='present';more.hidden=visibleMasses>=3;helpRefresh.forEach(fn=>fn());}
 const normalVeg=$('veg').parentElement.querySelector('.normal-button');normalVeg.onclick=()=>{if((v('veg')||other().some(x=>v(x.pre+'Type')==='vegetation'))&&!confirm('Replace vegetation entries with “No vegetation seen on TTE”?'))return;$('veg').value=normalText.veg;other().forEach(x=>{if(v(x.pre+'Type')==='vegetation')x.card.querySelectorAll('input,select,textarea').forEach(el=>el.value='');});changed();refreshMass();};
 for(const x of masses)$(x.pre+'Type').addEventListener('change',()=>{if(v(x.pre+'Type')==='vegetation'&&v('veg')===normalText.veg)$('veg').value='';refreshMass();});$('lvSec').addEventListener('change',refreshMass);
 window.structuredFindingErrors=function(){const errors=[];for(const x of masses){if(!['vegetation','thrombus','mass'].includes(v(x.pre+'Type')))continue;if((positive(n(x.pre+'Width'))||positive(n(x.pre+'Depth')))&&!positive(n(x.pre+'Length')))errors.push('Enter the length for '+x.pre+'.');if(v(x.pre+'Type')==='vegetation'&&/no vegetation/i.test(v('veg')))errors.push('Review the conflicting vegetation entries.');}if(['thrombus','mass'].includes(v('lvMassType'))&&/\bno\s+(?:LV\s+)?thrombus\b/i.test(v('lvnotes')))errors.push('Review conflicting LV thrombus entries.');
  for(const [id,title]of valves)for(const [key,abbreviation,word]of [['reg',id[0].toUpperCase()+'R','regurgitation'],['sten',id[0].toUpperCase()+'S','stenosis']])if(v(id+key+'State')==='present'&&new RegExp('\\bno (?:'+abbreviation+'|'+title+' '+word+')\\b','i').test(v(id)))errors.push('Review conflicting '+title.toLowerCase()+' '+word+' entries.');return errors;};
 $('form').addEventListener('clinicalupdate',()=>{refresh();refreshMass();});
 const restore=restoreStudy;restoreStudy=function(record){restore(record);masses.forEach(x=>{if(['Homogeneous','Heterogeneous'].includes(v(x.pre+'Echo'))&&!v(x.pre+'Texture')){$(x.pre+'Texture').value=v(x.pre+'Echo');$(x.pre+'Echo').value='';}x.appearance.open=['Shape','Surface','Echo','Texture','Mobility','Attachment'].some(k=>v(x.pre+k));});visibleMasses=Math.max(1,...other().map((x,i)=>v(x.pre+'Type')?i+1:1));activeValve=records.find(x=>hasStructuredValve(x.id)||v(x.id)&&v(x.id)!==normalText[x.id])?.id||'mv';lastValve='';refresh();refreshMass();for(const x of records)x.textFold.open=!!v(x.id);massPanel.open=!!structuredMassReport();lvPanel.open=!!structuredLVReport();};refresh();refreshMass();
 const reference=document.createElement('p');reference.innerHTML='Description terminology: <a href="https://www.asecho.org/wp-content/uploads/2025/09/PIIS0894731725002925.pdf" target="_blank" rel="noopener">ASE adult reporting (2025), Table 9</a>. Mass assessment: <a href="https://www.asecho.org/wp-content/uploads/2016/01/2016_Cardiac-Source-of-Embolism.pdf" target="_blank" rel="noopener">ASE cardiac sources of embolism (2016)</a>. Brief explanations and examples are teaching aids and are not included in patient reports.';document.querySelector('.reference')?.append(reference);
})();

