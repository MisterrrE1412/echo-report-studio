const $=id=>document.getElementById(id);const segments=['Basal anterior','Basal anteroseptal','Basal inferoseptal','Basal inferior','Basal inferolateral','Basal anterolateral','Mid anterior','Mid anteroseptal','Mid inferoseptal','Mid inferior','Mid inferolateral','Mid anterolateral','Apical anterior','Apical septal','Apical inferior','Apical lateral','Apical cap'];
function field(id,label,type='text',opts){let el=document.createElement('label');el.className='field'+(type==='textarea'?' wide':'');el.textContent=label;let x=document.createElement(type==='select'?'select':type==='textarea'?'textarea':'input');x.id=id;x.name=id;if(type==='select'){for(const [v,t] of opts.map(o=>Array.isArray(o)?o:[o,o])){let op=document.createElement('option');op.value=v;op.textContent=t;x.append(op)}}else if(type!=='textarea'){x.type=type;if(type==='number'){x.min='0';x.max='10000';x.step='any';x.inputMode='decimal'}x.placeholder=type==='number'?'—':''}el.append(x);return el}
const F=(id,l,t='text',o)=>[id,l,t,o];function fill(parent,fields){fields.forEach(f=>parent.append(field(...f)))}
fill($('patient'),[F('name','Patient name'),F('mrn','MRN'),F('ward','Ward / clinic'),F('date','Study date','date'),F('sex','Sex','select',[['','Not specified'],'Female','Male']),F('operator','Performed by'),F('height','Height (cm)','number'),F('weight','Weight (kg)','number'),F('bsa','BSA (m²), if known','number'),F('indication','Clinical indication')]);$('date').value=new Date().toLocaleDateString('en-CA');
function section(title,fields,open=false){const d=document.createElement('details');d.open=open;const s=document.createElement('summary');s.textContent=title;d.append(s);let g=document.createElement('div');g.className='grid';fill(g,fields);d.append(g);$('sections').append(d);return g}
section('Study quality & rhythm',[F('quality','Study quality','select',['Adequate','Technically limited']),F('rhythm','Rhythm','select',[['','Not documented'],'Sinus rhythm','Atrial fibrillation','Paced rhythm','Other']),F('hr','Heart rate (bpm)','number'),F('fused','Mitral inflow','select',[['','Not documented'],'Separable','Fused due to tachycardia']),F('windows','Usable views / limitations','textarea')],true);
section('Left ventricle',[F('efMethod','LVEF method','select',[['biplane','Simpson biplane'],['visual','Visual estimate — range']]),F('efLow','Estimated LVEF lower (%)','number'),F('efHigh','Estimated LVEF upper (%)','number'),F('ef','Simpson’s biplane LVEF (%)','number'),F('lvsize','LV size','select',[['','Not assessed'],'Normal','Dilated','Small']),F('lvfunction','LV systolic function','select',[['','Not specified'],'Normal','Mildly reduced','Moderately reduced','Severely reduced','Hyperdynamic']),F('thickness','Wall thickness / hypertrophy pattern'),F('ivsd','IVSd (cm)','number'),F('lvidd','LVIDd (cm)','number'),F('lvpwd','LVPWd (cm)','number'),F('lvnotes','LV thrombus / spontaneous echo contrast / other findings','textarea')]);
const dg=section('Diastolic function · ASE 2025',[F('e','Mitral E velocity (cm/s)','number'),F('a','Mitral A velocity (cm/s)','number'),F('sept','Septal e′ (cm/s)','number'),F('lat','Lateral e′ (cm/s)','number'),F('dt','Deceleration time (ms)','number'),F('diastolic','Manual interpretation (optional override)','select',[['','Use automatic ASE 2025 result'],['Normal LV diastolic function with normal estimated left atrial pressure.','Normal function / normal LAP'],['Grade I LV diastolic dysfunction with normal estimated left atrial pressure.','Grade I / normal LAP'],['Grade II LV diastolic dysfunction with elevated estimated left atrial pressure.','Grade II / elevated LAP'],['Grade III LV diastolic dysfunction with elevated estimated left atrial pressure.','Grade III / elevated LAP'],['Indeterminate LV diastolic function.','Indeterminate']]),F('diastolicnotes','Supporting assessment (LA strain, pulmonary veins, IVRT, special conditions)','textarea')]);
section('Atria, RV & pulmonary pressure',[F('lavol','Measured LA volume (mL)','number'),F('lamethod','LA volume method','select',['Biplane','Single-plane 4-chamber','Single-plane 2-chamber']),F('la','LA assessment','select',[['','Not assessed'],'Normal','Dilated']),F('ra','RA size','select',[['','Not assessed'],'Normal','Dilated']),F('rvsize','RV size','select',[['','Not assessed'],'Normal','Dilated']),F('rvfunction','RV systolic function','select',[['','Not assessed'],'Normal','Reduced']),F('tapse','TAPSE (cm)','number'),F('sprime','RV S′ (cm/s)','number'),F('fac','RV FAC (%)','number'),F('tr','TR Vmax (cm/s)','number'),F('ivc','IVC diameter (cm)','number'),F('collapse','IVC collapse with sniff','select',[['','Not assessed'],['gt','More than 50%'],['le','50% or less']]),F('rap','Estimated RAP, if supplied (mmHg)','number'),F('ivcmode','RAP context','select',['Spontaneously breathing','Mechanical ventilation / unsuitable']),F('pred','PR end-diastolic gradient (mmHg)','number'),F('rvnotes','RV / pulmonary pressure interpretation','textarea')]);
section('Valves & septa',[F('mv','Mitral valve findings','textarea'),F('av','Aortic valve findings / prosthesis','textarea'),F('tv','Tricuspid valve findings','textarea'),F('pv','Pulmonary valve findings','textarea'),F('notr','Measurable TR jet','select',[['','Not documented'],'No measurable TR jet','Measurable TR jet']),F('septa','IAS / IVS findings','textarea')]);
const wg=section('Regional wall motion · 17 segments',[F('motion','Global wall motion','select',[['','Not assessed'],'No RWMA','Global hypokinesia','Regional wall motion abnormality']),F('remaining','Unspecified segments','select',[['','Unassessed'],['normal','Confirmed normal']])]);let note=document.createElement('p');note.className='note';note.textContent='Score every visualized segment or confirm that the remaining segments are normal. Unvisualized segments are excluded from the denominator.';wg.append(note);segments.forEach((s,i)=>wg.append(field('s'+i,(i+1)+'. '+s,'select',[['','Unspecified'],['1','Normal (1)'],['2','Hypokinetic (2)'],['3','Akinetic (3)'],['4','Dyskinetic (4)'],['x','Not visualized']])));
section('HCM / HOCM assessment',[F('hcm','Morphology, SAM, MR, aneurysm and other HCM findings','textarea'),F('maxwall','Maximum wall thickness (mm)','number'),...['lvot','mid','apical'].flatMap((x,i)=>[F(x+'rest',['LVOT','Mid-LV','Apical'][i]+' resting velocity (m/s)','number'),F(x+'prov',['LVOT','Mid-LV','Apical'][i]+' Valsalva velocity (m/s)','number')])]);
section('Pericardium, vegetation & conclusion',[F('peri','Pericardium findings','textarea'),F('veg','Vegetation assessment','textarea'),F('conclusion','Additional conclusion / clinical interpretation','textarea')]);
const n=id=>{const v=$(id).value.trim();return v===''?null:Number(v)},v=id=>$(id).value.trim(),r=(x,d=2)=>Number(x).toFixed(d),present=x=>x!==null&&Number.isFinite(x),positive=x=>present(x)&&x>0;
function currentEF(){return ReportCore.efReport({method:v('efMethod'),ef:n('ef'),low:n('efLow'),high:n('efHigh'),sex:v('sex'),age:n('age')});}
const chamberFields={
 lv:[['lvEdv','Biplane LV EDV','mL'],['lvEsv','Biplane LV ESV','mL']],
 la:[['laDiameter','LA AP diameter','cm'],['laArea','LA area (A4C)','cm²']],
 ra:[['raMajor','RA major-axis length','cm'],['raMinor','RA minor-axis diameter','cm'],['raArea','RA area (A4C)','cm²'],['raVolume','RA volume','mL']],
 rv:[['rvBasal','RV basal diameter','cm'],['rvMid','RV mid-cavity diameter','cm'],['rvLength','RV longitudinal length','cm'],['rvEda','RV end-diastolic area','cm²'],['rvEsa','RV end-systolic area','cm²']]
};
function chamberMeasurements(key,c){const parts=chamberFields[key].filter(([id])=>positive(n(id))).map(([id,label,unit])=>label+' '+n(id)+' '+unit+'.');if(positive(c.b)){for(const [id,label]of (key==='lv'?[['lvEdv','LV EDV index'],['lvEsv','LV ESV index']]:key==='ra'?[['raVolume','RA volume index']]:[]))if(positive(n(id)))parts.push(label+' '+r(n(id)/c.b,1)+' mL/m².');}return parts.join(' ');}
function calculate(){const h=n('height'),w=n('weight');const b=positive(n('bsa'))?n('bsa'):positive(h)&&positive(w)?.007184*h**.725*w**.425:null;const rw=positive(n('lvidd'))&&positive(n('lvpwd'))?2*n('lvpwd')/n('lvidd'):null;const mass=['ivsd','lvidd','lvpwd'].every(k=>positive(n(k)))?.8*1.04*((n('ivsd')+n('lvidd')+n('lvpwd'))**3-n('lvidd')**3)+.6:null;let rap=n('rap');if(!present(rap)&&positive(n('ivc'))&&v('collapse')&&v('ivcmode')==='Spontaneously breathing')rap=n('ivc')<=2.1&&v('collapse')==='gt'?3:n('ivc')>2.1&&v('collapse')==='le'?15:8;let scores=segments.map((s,i)=>v('s'+i)==='x'?null:v('s'+i)?Number(v('s'+i)):v('motion')==='Global hypokinesia'?2:v('motion')==='No RWMA'||v('remaining')==='normal'?1:null);let assessed=scores.slice(0,16).filter(present),total=assessed.reduce((a,b)=>a+b,0);return{b,bmi:positive(h)&&positive(w)?w/(h/100)**2:null,rw,mass,lvmi:b&&mass?mass/b:null,lavi:positive(n('laviDirect'))?n('laviDirect'):b&&positive(n('lavol'))?n('lavol')/b:null,rap,trpg:positive(n('tr'))?4*(n('tr')/100)**2:null,es:positive(n('e'))&&positive(n('sept'))?n('e')/n('sept'):null,el:positive(n('e'))&&positive(n('lat'))?n('e')/n('lat'):null,scores,total,count:assessed.length,wmsi:assessed.length?total/assessed.length:null}}
function renderMetrics(c){const met=$('metrics');met.children[0].querySelector('strong').textContent=c.b?r(c.b):'—';met.children[1].querySelector('strong').textContent=c.lavi?r(c.lavi,1):'—';met.children[2].querySelector('strong').textContent=c.wmsi?r(c.wmsi):'—'}
let generated=false,dirty=false;function toast(t){$('toast').textContent=t;$('toast').style.display='block';setTimeout(()=>$('toast').style.display='none',3000)}
$('form').addEventListener('input',()=>{if(generated){dirty=true;$('status').textContent='Findings changed';['copy','print','download'].forEach(id=>$(id).disabled=true)}});
function generate(){const c=calculate(),grades=measurementGrades(c),out=[],con=[];const add=(heading,txt)=>{if(txt.trim())out.push([heading,txt.trim()])};let errs=typeof structuredFindingErrors==='function'?structuredFindingErrors():[];if(typeof quickFindingErrors==='function')errs.push(...quickFindingErrors());if(typeof greatArteryAssessment==='function')errs.push(...greatArteryAssessment().errors);for(const fields of Object.values(chamberFields))for(const [id,label]of fields)if(present(n(id))&&n(id)<=0)errs.push(label+' must be greater than zero.');if(positive(n('lvEdv'))&&positive(n('lvEsv'))&&n('lvEsv')>n('lvEdv'))errs.push('LV ESV cannot exceed LV EDV.');if(positive(n('rvEda'))&&positive(n('rvEsa'))&&n('rvEsa')>n('rvEda'))errs.push('RV end-systolic area cannot exceed end-diastolic area.');if(v('efMethod')==='visual'&&!currentEF().text)errs.push('Enter a valid estimated LVEF range from 0 to 100%, with lower ≤ upper.');if(v('diastolic')&&!v('overrideReason'))errs.push('Enter a reason for the manual diastolic override.');for(const id of ['height','weight','bsa','ivsd','lvidd','lvpwd','lavol','sept','lat','ivc'])if(present(n(id))&&n(id)<=0)errs.push(id+' must be greater than zero.');if(n('ef')>100||n('fac')>100)errs.push('LVEF and FAC cannot exceed 100%.');if(['No RWMA','Global hypokinesia'].includes(v('motion'))&&segments.some((s,i)=>v('s'+i)&&v('s'+i)!=='x'&&Number(v('s'+i))!==(v('motion')==='No RWMA'?1:2)))errs.push('Global wall motion and individual segment scores conflict.');if(errs.length){toast(errs.join(' '));return}
add('Patient & Study',[v('name')&&'Name: '+v('name'),v('mrn')&&'MRN: '+v('mrn'),v('ward')&&'Ward / clinic: '+v('ward'),v('date')&&'Study date: '+v('date'),v('sex')&&'Sex: '+v('sex'),positive(n('age'))&&'Age: '+n('age')+' years',positive(n('sbp'))&&positive(n('dbp'))&&'BP: '+n('sbp')+'/'+n('dbp')+' mmHg',v('operator')&&'Performed by: '+v('operator'),v('indication')&&'Indication: '+v('indication')].filter(Boolean).join('\n'));
const limited=v('quality')==='Technically limited';add('Study Quality',(limited?'Technically limited echocardiographic study due to poor acoustic windows.':'Adequate study quality.')+' '+v('windows'));
let phys=[];if(positive(n('height')))phys.push('Height '+r(n('height'),1)+' cm');if(positive(n('weight')))phys.push('Weight '+r(n('weight'),1)+' kg');if(c.b)phys.push('BSA '+r(c.b)+' m² ('+(positive(n('bsa'))?'supplied':'Du Bois')+')');if(c.bmi)phys.push('BMI '+r(c.bmi,1)+' kg/m²');add('Physical Parameters',phys.join('; '));add('Rhythm',(v('rhythm')==='Atrial fibrillation'?'Atrial fibrillation during the study.':v('rhythm')?v('rhythm')+'.':'')+(positive(n('hr'))?' Heart rate '+n('hr')+' bpm.':''));
let lv=[];if(grades.lvidd||v('lvsize'))lv.push((grades.lvidd||v('lvsize'))+' LV cavity size.');if(v('thickness'))lv.push(v('thickness'));if(grades.ef||(v('efMethod')!=='visual'&&v('lvfunction'))){let t=(grades.ef||v('lvfunction'))+' LV systolic function.';con.push(t)}if(currentEF().text)lv.push(currentEF().text);for(const [id,l]of [['ivsd','IVSd'],['lvidd','LVIDd'],['lvpwd','LVPWd']])if(positive(n(id)))lv.push(l+' '+r(n(id))+' cm'+'.');if(c.rw)lv.push('RWT '+r(c.rw)+'.');if(c.mass)lv.push('Linear LV mass '+r(c.mass,1)+' g'+'.');if(c.lvmi){lv.push('LVMI '+r(c.lvmi,1)+' g/m²'+'.');if(grades.geometry){con.push(grades.geometry+'.');if(v('hcm')||/asymmetr|hcm/i.test(v('thickness')))lv.push('Linear LV mass and conventional geometry may not adequately characterize asymmetric hypertrophy.')}}
let abnormal=c.scores.map((s,i)=>s>1?['','normal','hypokinetic','akinetic','dyskinetic'][s]+' '+segments[i].toLowerCase():null).filter(Boolean);if(abnormal.length){let t=(v('motion')==='Global hypokinesia'?'Global hypokinesia':ReportCore.motionText(c.scores,segments).replace(/\.$/,''))+'.';con.push(t)}else if(c.count&&c.scores.every(x=>x===null||x===1))lv.push('No regional wall motion abnormality in the assessed segments.');if(v('lvnotes')){lv.push(v('lvnotes'));con.push(v('lvnotes'))}if(typeof structuredLVReport==='function'&&structuredLVReport()){lv.push(structuredLVReport());con.push(structuredLVReport(true));}
let dia=[];const dd=diaData();for(const [id,l,unit]of [['e','Mitral E','cm/s'],['a','Mitral A','cm/s'],['sept','Septal e′','cm/s'],['lat','Lateral e′','cm/s']])if(present(dd[id]))dia.push(l+' '+dd[id]+' '+unit+'.');const dr=diastolicAssessment();if(present(dr.ea))dia.push('E/A '+r(dr.ea)+'.');if(present(dr.ee))dia.push((dr.eeSite==='septal'?'Septal':dr.eeSite==='lateral'?'Lateral':'Average')+' E/e′ '+r(dr.ee)+'.');if(dd.noTR)dia.push('TR velocity not measurable.');const auto=diastolicAssessment();let di=ReportCore.clinicalDiastolic(auto,diaData(),v('quickContext')?v('diastolic'):'');dia.push(di);con.push(di);dia.push(diastolicMeasurements());dia.push(v('diastolicnotes'));lv.push(chamberMeasurements('lv',c));add('Left Ventricle (LV)',lv.filter(Boolean).join(' '));add('Diastolic Function',dia.filter(Boolean).join(' '));
let rv=[];if(v('rvsize'))rv.push(v('rvsize')+' RV size.');if(v('rvfunction')){con.push(v('rvfunction')+' RV systolic function.')}if(positive(n('tapse')))rv.push('TAPSE '+r(n('tapse'))+' cm'+'.');if(present(n('sprime')))rv.push('RV S′ '+n('sprime')+' cm/s'+'.');if(present(n('fac')))rv.push('RV FAC '+n('fac')+'%'+'.');rv.push(chamberMeasurements('rv',c));rv.push(v('rvnotes'));add('Right Ventricle (RV)',rv.filter(Boolean).join(' ')||'Not assessed.');
let la=[];if(v('la')&&!c.lavi)la.push(v('la')+' LA size.');if(positive(n('lavol')))la.push('LA volume '+n('lavol')+' mL ('+v('lamethod').toLowerCase()+').');if(c.lavi){let grade=c.lavi<=34?'within normal limits':c.lavi<=41?'mildly increased':c.lavi<=48?'moderately increased':'severely increased';let t='LAVI '+r(c.lavi,1)+' mL/m² ('+(positive(n('laviDirect'))?'supplied indexed volume':v('lamethod').toLowerCase())+').';la.push(t);if(c.lavi>34)con.push(t);}la.push(chamberMeasurements('la',c));add('Left Atrium (LA)',la.filter(Boolean).join(' ')||'Not assessed.');let ra=v('ra')?v('ra')+' RA size.':'RA size not assessed.';if(positive(n('ivc')))ra+=' IVC diameter '+n('ivc')+' cm'+'.';if(v('collapse'))ra+=' Inspiratory collapse '+(v('collapse')==='gt'?'>50%':'≤50%')+'.';if(present(c.rap))ra+=' Estimated RAP '+c.rap+' mmHg'+(present(n('rap'))?' (supplied).':' (IVC-based estimate).');ra+=' '+chamberMeasurements('ra',c);add('Right Atrium (RA) / IVC',ra);add('Interatrial Septum (IAS) and Interventricular Septum (IVS)',v('septa')||'Not assessed.');
for(const[id,label]of [['mv','Mitral Valve (MV)'],['av','Aortic Valve (AV)'],['tv','Tricuspid Valve (TV)'],['pv','Pulmonary Valve (PV)']]){let val=[ReportCore.polishValve(v(id)),typeof structuredValveReport==='function'?structuredValveReport(id):''].filter(Boolean).join(' ');if(id==='tv'&&v('notr')==='No measurable TR jet')val+=' No measurable tricuspid regurgitation jet.';add(label,val|| (limited?'Poorly visualized; morphology and function cannot be adequately assessed.':'Not assessed.'));if(v(id))con.push(ReportCore.polishValve(v(id)));if(typeof structuredValveReport==='function'&&structuredValveReport(id,true))con.push(structuredValveReport(id,true));}
if(typeof greatArteryAssessment==='function'){const arteries=greatArteryAssessment();add('Great Arteries',arteries.body);if(arteries.conclusion)con.push(arteries.conclusion);}
let pp=[];if(typeof currentPressure==='function')pp.push(ClinicalDetails.pressureText(currentPressure(c)));else if(c.trpg&&present(c.rap))pp.push('TR max gradient '+r(c.trpg,1)+' mmHg. Estimated RVSP '+r(c.trpg+c.rap,1)+' mmHg.');if(present(n('pred'))&&present(c.rap))pp.push('Pulmonary regurgitation Doppler-derived PAEDP approximately '+r(n('pred')+c.rap,1)+' mmHg.');add('Pulmonary Pressure',pp.join(' '));add('Pericardium',v('peri')||(limited?'Assessment limited by poor visualization.':'Not assessed.'));if(v('peri'))con.push(v('peri'));const massText=typeof structuredMassReport==='function'?structuredMassReport():'';add('Vegetation / Thrombus / Mass',[v('veg'),massText].filter(Boolean).join(' ')||(limited?'Assessment for valvular vegetation is limited by poor visualization.':'Not assessed.'));if(v('veg'))con.push(v('veg'));if(massText)con.push(structuredMassConclusion());
if(c.count){let lines=c.scores.map((s,i)=>(i+1)+'. '+segments[i]+': '+(present(s)?['','Normal','Hypokinesia','Akinesia','Dyskinesia'][s]+' (score '+s+')':'not assessed')).join('\n');add('Wall Motion Score',lines+'\nTotal wall-motion score '+c.total+' across '+c.count+' assessed segments. WMSI = '+c.total+' / '+c.count+' = '+r(c.wmsi)+'.'+(c.count<16?' Partial assessment: '+(17-c.count)+' segments excluded.':''));if(abnormal.length)con.push('WMSI '+r(c.wmsi)+' ('+c.count+' assessed segments).')}
let hc=[];if(v('hcm'))hc.push(v('hcm'));if(positive(n('maxwall')))hc.push('Maximum LV wall thickness '+n('maxwall')+' mm.');for(const [id,l] of [['lvot','LVOT'],['mid','Mid-LV'],['apical','Apical']]){let parts=[];for(const [k,t]of [['rest','resting'],['prov','Valsalva']])if(present(n(id+k)))parts.push(t+' gradient '+r(4*n(id+k)**2,1)+' mmHg (velocity '+n(id+k)+' m/s)');if(parts.length)hc.push(l+': '+parts.join('; ')+'.')}add('HCM / HOCM Assessment',hc.join(' '));if(hc.length)con.push(hc.join(' '));if(v('conclusion'))con.push(v('conclusion'));if(limited)con.push('Interpretation is limited by suboptimal acoustic windows.');add('Conclusion',summaryParagraph(c,con)||'Insufficient documented findings for a clinical conclusion.');$('report').replaceChildren();out.forEach(([head,txt])=>{let h=document.createElement('h3');h.textContent=head;let p=document.createElement('p');p.textContent=txt;$('report').append(h,p)});generated=true;dirty=false;renderMetrics(c);$('status').textContent='Draft · review required';['copy','print','download'].forEach(id=>$(id).disabled=false);if(typeof reportGenerated==='function')reportGenerated();if(innerWidth<901)$('report').scrollIntoView({behavior:'smooth',block:'start'});}
$('form').addEventListener('submit',e=>{e.preventDefault();generate()});$('copy').onclick=async()=>{try{await navigator.clipboard.writeText($('report').innerText);toast('Report copied')}catch{toast('Select the report text and copy it manually.')}};$('print').onclick=()=>window.print();$('download').onclick=()=>{let blob=new Blob([$('report').innerText],{type:'text/plain;charset=utf-8'}),url=URL.createObjectURL(blob),a=document.createElement('a');a.href=url;a.download='echo-report.txt';a.click();setTimeout(()=>URL.revokeObjectURL(url),1000)};$('clear').onclick=()=>{if(confirm('Clear this study and start a new report?'))location.reload()};window.addEventListener('beforeunload',e=>{if(typeof skipRecoverySave!=='undefined'&&skipRecoverySave)return;if(generated||[...$('form').elements].some(x=>x.tagName==='INPUT'&&x.type!=='date'&&x.value)){e.preventDefault();e.returnValue=''}});
