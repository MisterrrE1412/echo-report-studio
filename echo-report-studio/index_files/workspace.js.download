// Concise reporting, explicit normal presets, and local study records.
function shortDiastolic(text){return text.replaceAll('LV diastolic dysfunction','diastolic dysfunction').replaceAll('estimated left atrial pressure','LAP').replaceAll('LV diastolic function','diastolic function');}
function prepareInterpretation(){/* Severity remains the operator's integrated interpretation. */}
function summaryParagraph(c,old){
 const parts=[],g=measurementGrades(c),lv=g.ef||(v('efMethod')==='visual'?'':v('lvfunction'));
 const ef=currentEF();if(ef.text)parts.push(ef.text.slice(0,-1)+(lv?', '+lv.toLowerCase()+' LV systolic function.':'.'));else if(lv)parts.push(lv+' LV systolic function.');
 if(g.lvidd||v('lvsize'))parts.push((g.lvidd||v('lvsize'))+' LV size.');
 if(v('thickness'))parts.push(v('thickness'));
 const excluded=/Simpson’s biplane LVEF|LV systolic function|RV systolic function|LAVI |WMSI /;
 old.filter(t=>!excluded.test(t)&&!Object.values(normalText).includes(t)).forEach(t=>parts.push(t));
 if(c.count&&c.scores.every(x=>x===null||x===1))parts.push(c.count===16?'No RWMA.':'No RWMA in assessed segments.');
 if(c.scores.some(x=>x>1))parts.push('WMSI '+r(c.wmsi)+(c.count<16?' ('+c.count+'/16 segments)':'')+'.');
 if(v('rvsize'))parts.push(v('rvsize')+' RV size.');
 if(positive(n('tapse')))parts.push('TAPSE '+Number(n('tapse'))+' cm'+(v('rvfunction')?', '+v('rvfunction').toLowerCase()+' RV systolic function.':g.tapse?', '+g.tapse.toLowerCase()+' RV longitudinal function.':'.'));
 else if(v('rvfunction'))parts.push(v('rvfunction')+' RV systolic function.');
 else if(g.fac)parts.push('RV FAC '+n('fac')+'%, '+g.fac.toLowerCase()+'.');
 else if(g.sprime)parts.push('RV S′ '+n('sprime')+' cm/s, '+g.sprime.toLowerCase()+'.');
 if(c.lavi)parts.push('LAVI '+r(c.lavi,1)+' mL/m², '+(c.lavi<=34?'normal LA size':c.lavi<=41?'mild LA enlargement':c.lavi<=48?'moderate LA enlargement':'severe LA enlargement')+'.');
 else if(v('la'))parts.push(v('la')+' LA size.');
 if(v('ra'))parts.push(v('ra')+' RA size.');
 if(v('rvnotes'))parts.push(v('rvnotes'));
 if(present(c.rap))parts.push('Estimated RAP '+c.rap+' mmHg.');
 if(['mv','av','tv','pv'].every(id=>v(id)===normalText[id]&&!(typeof hasStructuredValve==='function'&&hasStructuredValve(id))))parts.push('No significant valve disease.');
 if(present(c.trpg)&&present(c.rap))parts.push('Estimated '+(v('noObstruction')==='yes'?'PASP (eRVSP)':'RVSP')+' '+r(c.trpg+c.rap,0)+' mmHg'+(g.rvsp?', '+g.rvsp.toLowerCase():'')+'.');
 if(v('septa'))parts.push(v('septa'));
 if(v('peri')===normalText.peri)parts.push(normalText.peri);
 if(v('veg')===normalText.veg)parts.push(normalText.veg);
 if(v('comparison'))parts.push(v('comparison'));
 return [...new Set(parts.map(t=>t.trim().replace(/[.]+$/,'')+'.').filter(t=>t!=='.'))].join(' ').replace(/\s+/g,' ');
}
const normalText={mv:'Normal mitral valve. No MR or MS.',av:'Normal aortic valve. No AR or AS.',tv:'Normal tricuspid valve. No significant TR or TS.',pv:'Normal pulmonary valve. No PR or PS.',septa:'No septal defect seen.',peri:'No pericardial effusion.',veg:'No vegetation seen on TTE.'};
for(const [id,text] of Object.entries(normalText)){
 const b=document.createElement('button');b.type='button';b.className='normal-button';b.textContent='Mark as normal';
 b.onclick=()=>{if((v(id)&&v(id)!==text)&&!confirm('Replace the current '+id.toUpperCase()+' findings with normal findings?'))return;$(id).value=text;changed();};$(id).before(b);
}
for(const [id,label]of [['mv','Mitral'],['av','Aortic'],['tv','Tricuspid'],['pv','Pulmonary']]){
 const row=document.createElement('div');row.className='valve-presets';
 for(const lesion of ['regurgitation','stenosis']){const sel=document.createElement('select');sel.setAttribute('aria-label',label+' '+lesion+' severity');sel.innerHTML='<option value="">Add '+lesion+'</option>'+['Trace','Mild','Moderate','Severe'].filter(x=>lesion==='regurgitation'||x!=='Trace').map(x=>'<option>'+x+'</option>').join('');sel.onchange=()=>{if(!sel.value)return;let text=sel.value+' '+label.toLowerCase()+' '+lesion+'.';if(v(id)===normalText[id])$(id).value='';const previous=v(id).replace(new RegExp('(?:Trace|Mild|Moderate|Severe) '+label.toLowerCase()+' '+lesion+'\\.','g'),'').trim();$(id).value=[previous,text].filter(Boolean).join(' ');if(id==='tv'&&lesion==='regurgitation'&&v('notr')==='No measurable TR jet')$('notr').value='';sel.value='';changed();};row.append(sel);}$(id).after(row);
}
const ivcButton=document.createElement('button');ivcButton.type='button';ivcButton.textContent='Mark IVC / RAP normal';ivcButton.onclick=()=>{if((v('ivc')||v('rap')||v('collapse'))&&!confirm('Replace IVC assessment with normal IVC and RAP 3 mmHg?'))return;$('ivc').value='';$('collapse').value='gt';$('rap').value='3';$('ivcmode').value='Spontaneously breathing';$('rvnotes').value=[v('rvnotes'),'Normal IVC size and collapse.'].filter(Boolean).join(' ');changed();};$('ivc').parentElement.append(ivcButton);
for(const ids of [['lvsize','lvfunction'],['rvsize','rvfunction'],['la','ra']]){const b=document.createElement('button');b.type='button';b.textContent='Mark '+(ids[0]==='lvsize'?'LV size / function':ids[0]==='rvsize'?'RV size / function':'atrial sizes')+' normal';b.onclick=()=>{if(ids.some(id=>v(id)&&v(id)!=='Normal')&&!confirm('Replace the existing assessment with normal?'))return;ids.forEach(id=>$(id).value='Normal');changed();};$(ids[0]).parentElement.before(b);}
$('conclusion').parentElement.after(field('comparison','Comparison with prior study (if available)','textarea'));
const refp=document.createElement('p');refp.innerHTML='Report format: <a target="_blank" rel="noopener" href="https://www.asecho.org/wp-content/uploads/2025/09/PIIS0894731725002925.pdf">ASE adult echo reporting (2025)</a>. Valve severity is selected after integrated assessment; colour jet appearance alone does not determine severity. Normal presets are operator confirmations.';document.querySelector('.reference').append(refp);
// Save only when requested. Records never leave this browser through this feature.
const storageKey='echo-studio-studies-v1';let activeStudy=null;
const panel=document.createElement('section');panel.className='card study-tools';panel.innerHTML='<h2>Saved studies</h2><p class="hint">Stored in this browser on this device. Anyone using this browser profile can open them. Images are not saved. Exported backups contain patient details.</p><div class="actions"><button type="button" id="saveStudy">Save study</button><button type="button" id="exportStudy">Export current study</button><button type="button" id="importStudy">Import backup</button><input type="file" id="backupFile" accept="application/json,.json" hidden></div><div id="savedStudies"></div>';$('form').before(panel);
function readStudies(){try{let a=JSON.parse(localStorage.getItem(storageKey)||'[]');return Array.isArray(a)?a:[]}catch{toast('Saved studies could not be read. Check browser storage.');return []}}
function snapshot(){let fields={};$('form').querySelectorAll('input[id],select[id],textarea[id]').forEach(el=>{if(el.type!=='file'&&!el.dataset.measurementControl)fields[el.id]=el.value;});return{schema:1,trUnit:'cm/s',id:activeStudy||ReportCore.studyId(),savedAt:new Date().toISOString(),fields,measurementUnits:typeof MeasurementUnits!=='undefined'&&MeasurementUnits.preferences?MeasurementUnits.preferences():{},reportHTML:generated&&!dirty&&typeof safeReportHTML==='function'?safeReportHTML($('report').innerHTML):null,report:generated&&!dirty?ReportCore.domBlocks($('report')):null};}
function renderSaved(){const root=$('savedStudies');root.replaceChildren();let all=readStudies();if(!all.length){root.textContent='No saved studies.';return;}all.forEach(record=>{let row=document.createElement('div');row.className='saved-row';let label=document.createElement('span');label.textContent=[record.fields.name||'Unnamed study',record.fields.mrn,record.fields.date].filter(Boolean).join(' · ');let open=document.createElement('button');open.type='button';open.textContent='Open';open.onclick=()=>{if(confirm('Open this study? Unsaved changes will be replaced.'))restoreStudy(record)};let del=document.createElement('button');del.type='button';del.textContent='Delete';del.onclick=()=>{if(confirm('Delete this saved study?'))try{localStorage.setItem(storageKey,JSON.stringify(readStudies().filter(x=>x.id!==record.id)));if(activeStudy===record.id)activeStudy=null;renderSaved()}catch{toast('Unable to delete the study.')}};row.append(label,open,del);root.append(row);});}
function restoreStudy(record){if(record.schema!==1||record.trUnit!=='cm/s'||!record.fields||typeof record.fields!=='object')throw new Error('Unsupported backup format or missing TR unit.');$('form').reset();for(const [id,value]of Object.entries(record.fields)){let el=$(id);if(el&&$('form').contains(el)&&['INPUT','SELECT','TEXTAREA'].includes(el.tagName)&&el.type!=='file'&&typeof value==='string')el.value=value;}activeStudy=record.id;generated=false;dirty=false;changed();$('report').replaceChildren();if(Array.isArray(record.report)){record.report.forEach(x=>{const el=document.createElement(x.heading?'h3':'p');el.textContent=ReportCore.cleanLegacy(x.text);$('report').append(el)});if(record.reportHTML&&typeof safeReportHTML==='function')$('report').innerHTML=safeReportHTML(record.reportHTML);generated=true;$('status').textContent='Saved draft · review required';['copy','print','download'].forEach(id=>$(id).disabled=false);}else{$('status').textContent='Study loaded · generate report';['copy','print','download'].forEach(id=>$(id).disabled=true);}toast('Study opened');}
$('saveStudy').onclick=()=>{try{const record=snapshot(),all=readStudies(),i=all.findIndex(x=>x.id===record.id);if(i>=0)all[i]=record;else all.unshift(record);localStorage.setItem(storageKey,JSON.stringify(all));activeStudy=record.id;renderSaved();toast('Study saved on this device');}catch{toast('Save failed. Export a backup instead.');}};
$('exportStudy').onclick=()=>{const url=URL.createObjectURL(new Blob([JSON.stringify(snapshot(),null,2)],{type:'application/json'}));let a=document.createElement('a');a.href=url;a.download='echo-study.json';a.click();setTimeout(()=>URL.revokeObjectURL(url),1000)};
$('importStudy').onclick=()=>$('backupFile').click();$('backupFile').onchange=async()=>{try{const file=$('backupFile').files[0];if(!file)return;if(file.size>2e6)throw new Error('Backup is too large.');const record=JSON.parse(await file.text());if(confirm('Import this study? Unsaved changes will be replaced.')){restoreStudy(record);activeStudy=null;}}catch(e){toast('Import failed: '+e.message)}finally{$('backupFile').value=''}};
renderSaved();
// OCR is loaded only on demand; images are decoded and recognized one at a time.
const imagePanel=document.createElement('section');imagePanel.className='card';imagePanel.innerHTML='<h2>Read measurements from images</h2><p class="hint">Choose up to 6 screenshots, each under 12 MB. Images are read one at a time to reduce phone memory use. Reads printed measurements, not anatomy. Review values and units before applying. Images stay on this device and are not saved; the reader downloads on first use.</p><label class="field">Echo images<input id="echoImage" type="file" multiple accept="image/png,image/jpeg,image/webp"></label><ul id="imageQueue"></ul><div class="actions"><button id="readImage" type="button" disabled>Read images</button><button id="cancelOcr" type="button" hidden>Cancel</button></div><p id="ocrStatus" role="status"></p><details><summary>Recognized text / manual fallback</summary><textarea id="ocrText" aria-label="Recognized image text" placeholder="For example: TR Vmax 2.8 m/s"></textarea><button id="parseText" type="button">Find measurements</button></details><div id="ocrCandidates"></div><button id="applyOcr" type="button" disabled>Apply checked measurements</button>';
panel.after(imagePanel);
const measurementSpecs=[
 ['ef','LVEF / EF (confirm biplane)','(?:LVEF|EF(?:\\s*\\([^)]*\\))?)','%'],
 ['tr','TR Vmax','TR\\s*(?:Vmax|max\\s*vel|vel(?:ocity)?)','cm/s'],
 ['e','Mitral E','(?:MV|Mitral)\\s*E(?:\\s*(?:vel|velocity|Vmax))?','cm/s'],
 ['a','Mitral A','(?:MV|Mitral)\\s*A(?:\\s*(?:vel|velocity|Vmax))?','cm/s'],
 ['sept','Septal e′','(?:Sept(?:al)?|Medial)\\s*e[′\x27’]','cm/s'],
 ['lat','Lateral e′','Lat(?:eral)?\\s*e[′\x27’]','cm/s'],
 ['tapse','TAPSE','TAPSE','cm'],['ivsd','IVSd','IVSd','cm'],['lvidd','LVIDd','LVIDd','cm'],['lvpwd','LVPWd','LVPWd','cm'],['ivc','IVC diameter','IVC(?:\\s*(?:diameter|diam))?','cm'],
 ['laviDirect','LAVI','LAVI','mL/m²'],['lavol','LA volume (confirm method)','LA\\s*(?:vol(?:ume)?)(?!\\s*(?:index|[24]))','mL'],['bsa','BSA','BSA','m²'],['dt','MV deceleration time','(?:MV\\s*)?(?:DT|DecT)','ms'],['fac','RV FAC','(?:RV\\s*)?FAC','%']
];
function parseMeasurements(text){let result=[];for(const [id,label,alias,targetUnit]of measurementSpecs){const re=new RegExp('(?:^|[\\s;])('+alias+')\\s*[:=]?\\s*(-?\\d+(?:[.,]\\d+)?)\\s*(mL/m[²2]|ml/m[²2]|cm/s|m/s|mm|cm|mL|ml|ms|m[²2]|%)?(?=\\s|$|[;,])','gim');for(const match of text.matchAll(re)){let value=Number(match[2].replace(',','.')),unit=match[3]||'',known=false;let norm=unit.toLowerCase().replace('2','²');if(norm===targetUnit.toLowerCase())known=true;else if(targetUnit==='cm/s'&&unit==='m/s'){value*=100;known=true;}else if(targetUnit==='cm'&&unit==='mm'){value/=10;known=true;}result.push({id,label,value,unit:targetUnit,known,source:match[0].trim()});}}return result;}
function showCandidates(){const root=$('ocrCandidates');root.replaceChildren();let values=parseMeasurements($('ocrText').value);values.forEach((item,i)=>{let row=document.createElement('div');row.className='ocr-row';row.dataset.field=item.id;let box=document.createElement('input');box.type='checkbox';box.setAttribute('aria-label','Confirm '+item.label);let title=document.createElement('label');title.textContent=item.label+' ('+item.unit+')';let value=document.createElement('input');value.type='number';value.step='any';value.min='0';value.value=item.value;value.setAttribute('aria-label',item.label+' reviewed value');title.append(value);let note=document.createElement('small');note.textContent='Read: '+item.source+(item.known?'':' · Unit missing or unclear: confirm the value in '+item.unit)+ (v(item.id)?' · Replaces current value '+v(item.id):'');row.append(box,title,note);root.append(row);});$('applyOcr').disabled=!values.length;$('ocrStatus').textContent=values.length?values.length+' candidate measurements. All are unchecked until you review them.':'No supported measurements found. Use a clear crop or enter values manually.';}
$('parseText').onclick=showCandidates;
$('applyOcr').onclick=()=>{const rows=[...$('ocrCandidates').children].filter(row=>row.querySelector('input[type=checkbox]').checked);if(!rows.length){toast('Check each reviewed measurement first.');return;}let ids=new Set();for(const row of rows){const input=row.querySelector('input[type=number]'),value=Number(input.value);if(ids.has(row.dataset.field)){toast('Select only one value for each parameter.');return;}ids.add(row.dataset.field);if(!input.value||!Number.isFinite(value)||value<=0||(['ef','fac'].includes(row.dataset.field)&&value>100)){toast('Correct invalid measurement values first.');return;}}if(rows.some(row=>v(row.dataset.field))&&!confirm('Replace the existing values for the checked measurements?'))return;rows.forEach(row=>{$(row.dataset.field).value=row.querySelector('input[type=number]').value;row.querySelector('input[type=checkbox]').checked=false;});if(ids.has('tr')&&v('notr')==='No measurable TR jet')$('notr').value='Measurable TR jet';changed();toast('Reviewed measurements applied. Complete findings, then generate the report.');};
