// Document-style editing; all recovered markup passes a restrictive sanitizer.
let safeHTMLSource=null,safeHTMLResult=null;
function safeReportHTML(source){
 if(source===safeHTMLSource)return safeHTMLResult;
 const doc=new DOMParser().parseFromString(String(source),'text/html'),out=document.createElement('div');
 const allowed=new Set(['P','DIV','H3','STRONG','B','EM','I','U','BR','UL','OL','LI']);
 function copy(node,parent){if(node.nodeType===3){parent.append(document.createTextNode(node.textContent));return;}if(node.nodeType!==1||['SCRIPT','STYLE','IFRAME','OBJECT','IMG','SVG','FORM','INPUT','BUTTON'].includes(node.tagName))return;
  if(!allowed.has(node.tagName)){Array.from(node.childNodes).forEach(n=>copy(n,parent));return;}
  const el=document.createElement(node.tagName.toLowerCase());if(['P','DIV','H3'].includes(node.tagName)){el.style.fontFamily='Arial, Helvetica, sans-serif';el.style.fontSize='11pt';el.style.lineHeight='1.45';el.style.margin=node.tagName==='H3'?'12pt 0 4pt':'0 0 8pt';if(node.tagName==='H3')el.style.fontWeight='bold';}
  Array.from(node.childNodes).forEach(n=>copy(n,el));parent.append(el);
 }
 Array.from(doc.body.childNodes).forEach(n=>copy(n,out));safeHTMLSource=source;safeHTMLResult=out.innerHTML;return safeHTMLResult;
}
const editorBar=document.createElement('div');editorBar.className='editor-toolbar';editorBar.setAttribute('role','toolbar');editorBar.setAttribute('aria-label','Report editing tools');
let editorRange=null,manuallyEdited=false;
for(const [label,command,arg]of [['Bold','bold'],['Italic','italic'],['Underline','underline'],['Subheading','formatBlock','h3'],['Paragraph','formatBlock','p'],['Undo','undo'],['Redo','redo']]){const button=document.createElement('button');button.type='button';button.textContent=label;button.title=label;button.onmousedown=e=>e.preventDefault();button.onclick=()=>{if(!generated)return;$('report').focus();const selection=window.getSelection();if(editorRange){selection.removeAllRanges();selection.addRange(editorRange);}document.execCommand(command,false,arg||null);manuallyEdited=true;$('report').dispatchEvent(new Event('input',{bubbles:true}));};editorBar.append(button);}
const expand=document.createElement('button');expand.type='button';expand.textContent='Expand editor';expand.onclick=()=>{const isFull=document.querySelector('.preview').classList.toggle('expanded-editor');expand.textContent=isFull?'Close expanded editor':'Expand editor';expand.setAttribute('aria-expanded',String(isFull));};editorBar.append(expand);
$('report').before(editorBar);$('report').setAttribute('aria-label','Editable report canvas');
document.addEventListener('selectionchange',()=>{const sel=window.getSelection();if(sel&&sel.rangeCount&&$('report').contains(sel.anchorNode)&&$('report').contains(sel.focusNode))editorRange=sel.getRangeAt(0).cloneRange();});
document.addEventListener('keydown',e=>{if(e.key==='Escape'){document.querySelector('.preview').classList.remove('expanded-editor');expand.textContent='Expand editor';}});
$('report').addEventListener('paste',e=>{e.preventDefault();document.execCommand('insertText',false,e.clipboardData.getData('text/plain'));});
$('report').addEventListener('input',()=>{manuallyEdited=true;if(!dirty)$('status').textContent='Edited draft · review required';});
const originalClipboard=reportClipboard;reportClipboard=function(){const data=originalClipboard();data.html='<div style="font-family:Arial,Helvetica,sans-serif;font-size:11pt;color:#000">'+safeReportHTML($('report').innerHTML)+'</div>';return data;};
const originalGenerate=generate;generate=function(){if(manuallyEdited&&!confirm('Regenerate from measurements? This replaces your report edits. Your input measurements will be kept.'))return;originalGenerate();};
function reportGenerated(){manuallyEdited=false;editorRange=null;if(typeof saveRecoveryDraft==='function')saveRecoveryDraft();}

// Persist immediately on every input, and again before the page is hidden or left.
const draftPrefix='echo-studio-recovery-v1-',draftSessionKey='echo-studio-recovery-tab';
let draftId=ReportCore.studyId();try{draftId=sessionStorage.getItem(draftSessionKey)||draftId;sessionStorage.setItem(draftSessionKey,draftId);}catch{/* Recovery still works through the stored draft list. */}
let restoringDraft=false,skipRecoverySave=false,hasDraftActivity=false;
const recovery=document.createElement('div');recovery.className='recovery-strip';recovery.innerHTML='<p id="recoveryStatus" role="status">Draft recovery is ready. Inputs and report edits save automatically in this browser. Images are not saved.</p><details id="recoveryList"><summary>Recover an unfinished study</summary><div id="recoveryOptions"></div></details>';$('form').before(recovery);
let recoveryTimer;
function queueRecovery(){clearTimeout(recoveryTimer);recoveryTimer=setTimeout(saveRecoveryDraft,200);}
function captureRecovery(){const record=snapshot();return{version:1,record:{...record,report:generated?(record.report||ReportCore.domBlocks($('report'))):null},reportHTML:generated?(record.reportHTML||safeReportHTML($('report').innerHTML)):null,generated,dirty,manuallyEdited,activeStudy,savedAt:new Date().toISOString(),openSections:[...$('sections').querySelectorAll('details')].map(d=>d.open)};}
function saveRecoveryDraft(){clearTimeout(recoveryTimer);if(restoringDraft||skipRecoverySave||!hasDraftActivity&&!generated)return;try{localStorage.setItem(draftPrefix+draftId,JSON.stringify(captureRecovery()));$('recoveryStatus').textContent='Draft saved on this device · '+new Date().toLocaleTimeString()+'. Inputs and report edits can be recovered after leaving.';}catch{$('recoveryStatus').textContent='Automatic recovery is unavailable or storage is full. Export a backup before leaving.';}}
function applyRecovery(draft){if(draft?.version!==1||!draft.record)throw new Error('Unsupported draft.');restoringDraft=true;try{restoreStudy(draft.record);if(draft.reportHTML&&draft.generated)$('report').innerHTML=safeReportHTML(draft.reportHTML);generated=!!draft.generated;dirty=!!draft.dirty||(typeof diastolicReportNeedsRefresh==='function'&&diastolicReportNeedsRefresh(draft.record));manuallyEdited=!!draft.manuallyEdited;activeStudy=draft.activeStudy||null;editorRange=null;hasDraftActivity=true;[...$('sections').querySelectorAll('details')].forEach((d,i)=>{if(typeof draft.openSections?.[i]==='boolean')d.open=draft.openSections[i]});['copy','print','download'].forEach(id=>$(id).disabled=!generated||dirty);$('status').textContent=dirty?'Recovered · regenerate after input changes':generated?'Recovered draft · review required':'Recovered inputs · generate report';refreshHospitalText();$('recoveryStatus').textContent='Recovered unfinished study from '+new Date(draft.savedAt).toLocaleString()+'.';}finally{restoringDraft=false;}saveRecoveryDraft();}
function listRecovery(){const holder=$('recoveryOptions');holder.replaceChildren();try{let drafts=[];for(let i=0;i<localStorage.length;i++){const key=localStorage.key(i);if(!key.startsWith(draftPrefix))continue;try{const data=JSON.parse(localStorage.getItem(key));if(data.version===1&&data.record?.fields)drafts.push({key,data});}catch{/* Ignore a malformed entry without discarding it. */}}drafts.sort((a,b)=>b.data.savedAt.localeCompare(a.data.savedAt));for(const {key,data}of drafts){const row=document.createElement('div');row.className='saved-row';const label=document.createElement('span');label.textContent=[data.record.fields.name||'Unnamed study',data.record.fields.mrn,new Date(data.savedAt).toLocaleString()].filter(Boolean).join(' · ');const open=document.createElement('button');open.type='button';open.textContent='Recover';open.onclick=()=>{if(hasDraftActivity||generated){if(!confirm('Recover this study and replace the current workspace?'))return;saveRecoveryDraft();draftId=ReportCore.studyId();try{sessionStorage.setItem(draftSessionKey,draftId)}catch{}}try{applyRecovery(data)}catch{toast('Could not recover this draft. Use a saved study or backup.')}};const del=document.createElement('button');del.type='button';del.textContent='Delete draft';del.onclick=()=>{if(confirm('Delete this recovery copy? Saved studies are kept.')){try{localStorage.removeItem(key);listRecovery()}catch{toast('Could not delete the draft.')}}};row.append(label,open,del);holder.append(row);}if(!drafts.length)holder.textContent='No unfinished studies.';}catch{holder.textContent='Browser storage is unavailable.';}}
$('recoveryList').addEventListener('toggle',()=>{if($('recoveryList').open)listRecovery()});
$('form').addEventListener('input',()=>{hasDraftActivity=true;queueRecovery()});$('form').addEventListener('change',()=>{hasDraftActivity=true;saveRecoveryDraft()});
$('report').addEventListener('input',()=>{hasDraftActivity=true;queueRecovery()});
window.addEventListener('pagehide',saveRecoveryDraft);window.addEventListener('beforeunload',saveRecoveryDraft);document.addEventListener('visibilitychange',()=>{if(document.visibilityState==='hidden')saveRecoveryDraft()});
// Save/open workflows also participate, without changing their existing record identity.
const openStoredStudy=restoreStudy;restoreStudy=function(record){const wasRestoring=restoringDraft;restoringDraft=true;try{openStoredStudy(record);manuallyEdited=!!record.report;hasDraftActivity=true;editorRange=null;}finally{restoringDraft=wasRestoring;}if(!restoringDraft)saveRecoveryDraft();};
$('clear').onclick=()=>{if(!confirm('Start a new study? The current workspace and its recovery draft will be cleared. Saved studies are kept.'))return;try{localStorage.removeItem(draftPrefix+draftId);}catch{toast('Could not clear the recovery draft.');return;}skipRecoverySave=true;location.reload();};
try{const saved=localStorage.getItem(draftPrefix+draftId);if(saved)applyRecovery(JSON.parse(saved));else{listRecovery();if($('recoveryOptions').querySelector('button')){$('recoveryList').open=true;$('recoveryStatus').textContent='An unfinished study is available below. Choose Recover to resume.';}}}catch{$('recoveryStatus').textContent='Recovery could not load. Check saved studies or import a backup.';}
