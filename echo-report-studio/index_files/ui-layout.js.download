// Presentation-only navigation. Existing controls, handlers and saved field IDs are retained.
(function(){
 const entry=document.querySelector('.entry'),toolsRow=document.createElement('div');toolsRow.className='workspace-tools';entry.prepend(toolsRow);
 for(const [section,title,caption]of [[panel,'Saved studies','Open, save & back up'],[imagePanel,'Image measurements','Upload up to 6 images']]){
  const fold=document.createElement('details'),summary=document.createElement('summary'),label=document.createElement('span'),hint=document.createElement('small');
  label.textContent=title;hint.textContent=caption;summary.append(label,hint);fold.append(summary);
  section.querySelector('h2').remove();while(section.firstChild)fold.append(section.firstChild);
  section.append(fold);section.classList.add('workspace-tool');toolsRow.append(section);
  fold.addEventListener('toggle',()=>section.classList.toggle('tool-open',fold.open));
 }
 const jump=document.createElement('nav');jump.className='section-shortcuts';jump.setAttribute('aria-label','Findings sections');
 const labels=['Study','LV','Diastolic','Chambers','Valves','Wall motion','HCM','Other'];
 Array.from($('sections').children).forEach((section,i)=>{
  section.id='finding-section-'+i;const button=document.createElement('button');button.type='button';button.textContent=section.dataset.shortcut||labels[i]||section.querySelector('summary').textContent;button.setAttribute('aria-controls',section.id);
  button.onclick=()=>{section.open=true;section.scrollIntoView({block:'start'});section.querySelector('summary').focus({preventScroll:true});};jump.append(button);
 });
 const preview=document.querySelector('.preview');preview.id='report-preview';
 const reportLink=document.createElement('button');reportLink.type='button';reportLink.textContent='Report preview';reportLink.onclick=()=>{preview.scrollIntoView({block:'start'});};jump.append(reportLink);
 gradingPanel.before(jump);if(!$('measurementGrades').querySelector('p'))gradingPanel.open=false;
 document.querySelector('.intro h1').textContent='Echo report workspace';
 document.querySelector('.intro p').textContent='Enter findings, mark wall motion and review your report.';
 copyHint.textContent='Use Copy hospital text for hospital free-text fields. Copy formatted keeps bold headings where the receiving system supports them.';
})();
