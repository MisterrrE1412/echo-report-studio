const modes={
 '2D':'Show anatomy, motion and chamber dimensions in more than one plane.',
 Color:'Locate flow and align spectral Doppler; jet size alone does not grade a lesion.',
 PW:'Measure flow at a chosen sample depth. Move the sample to the intended anatomical site.',
 CW:'Record high velocity along the entire beam; align well and identify which jet produced the signal.',
 TDI:'Sample annular tissue motion; use tissue settings and align with annular movement.',
 'M-mode':'Record movement over time along one line; align TAPSE with longitudinal annular motion.',
 Strain:'Track myocardial deformation from suitable loops; use validated software and adequate image quality.'
};
const statusLabels={pending:'Not yet acquired',done:'Acquired / reviewed',unobtainable:'Not measurable',unreliable:'Unreliable',na:'Not applicable'};
const normalize=x=>String(x||'').toLowerCase().replace(/[^a-z0-9]+/g,' ').trim();
function search(query){const q=normalize(query);if(!q)return protocols;return protocols.filter(p=>[p.title,...p.aliases].some(term=>{const t=normalize(term);return t===q||(q.length>2&&t.includes(q))||(' '+q+' ').includes(' '+t+' ');}));}
function cleanState(input){const result={version:1,selected:'',states:{}};let x;try{x=typeof input==='string'?JSON.parse(input):input;}catch{return result;}if(!x||x.version!==1)return result;if(protocols.some(p=>p.id===x.selected))result.selected=x.selected;for(const p of protocols){const saved=x.states?.[p.id];if(!saved||typeof saved!=='object')continue;const rows={};for(const item of p.items)if(Object.hasOwn(statusLabels,saved[item.id]))rows[item.id]=saved[item.id];result.states[p.id]=rows;}return result;}
function progress(id,states={}){const p=protocols.find(x=>x.id===id);if(!p)return null;const core=p.items.filter(x=>!x.optional),get=x=>Object.hasOwn(statusLabels,states[x.id])?states[x.id]:'pending';const count=state=>core.filter(x=>get(x)===state).length;return{total:core.length,done:count('done'),na:count('na'),unavailable:count('unobtainable'),unreliable:count('unreliable'),pending:count('pending'),next:core.find(x=>get(x)==='pending')||core.find(x=>get(x)==='unreliable')||null};}
function discussionPrompt(id,states={}){const p=protocols.find(x=>x.id===id);if(!p)return '';return ['Help me plan an adult TTE acquisition for: '+p.title+'.','I am a CVT. Explain the next useful views, 2D, Color, PW, CW and TDI acquisitions and why. Cite applicable primary ASE/EACVI or other society guidance. Ask for missing context; do not infer a diagnosis or normal findings from an incomplete checklist.','Acquisition checklist (not patient results):',...p.items.map(x=>x.title+': '+(statusLabels[states[x.id]]||statusLabels.pending)), 'No patient measurements or identifiers are included. I will add de-identified findings separately.', 'Reference links:',...p.refs.map(k=>refs[k].url)].join('\n');}
const api={refs,protocols,modes,statusLabels,search,cleanState,progress,discussionPrompt};root.StudyProtocols=api;if(typeof module!=='undefined')module.exports=api;
})(typeof window!=='undefined'?window:globalThis);

