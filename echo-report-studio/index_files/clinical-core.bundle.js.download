 const wrap=(title,body)=>`<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 540 365" role="img" aria-label="${title}"><rect width="540" height="365" fill="#fafcfe"/>${body}</svg>`;
 const figures={
 plax:{title:'PLAX orientation',svg:wrap('Parasternal long-axis orientation',
 line('M45 187 Q125 66 311 146 L382 139 L498 111 L508 164 L376 193 Q354 221 303 240 Q151 296 45 245 Z','#e1eaf0')+
 line('M50 204 Q161 119 302 170 L375 159 L493 135 L497 151 L378 176 L318 214 Q168 265 50 229 Z')+
 line('M41 139 Q140 70 293 116 L283 88 Q129 40 39 108 Z')+
 line('M326 228 Q342 291 400 292 Q481 283 486 208 L486 181 L390 203 Z')+
 line('M298 171 L275 188 M317 214 L282 211','none')+line('M385 153 L401 164 L391 174','none')+
