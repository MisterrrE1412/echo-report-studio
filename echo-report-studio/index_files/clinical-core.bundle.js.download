/* clinical-details-core.js */
/* Small, dependency-free reporting helpers. No diagnosis is inferred from mass morphology. */
(function(root){
 const ok=x=>typeof x==='number'&&Number.isFinite(x),pos=x=>ok(x)&&x>0;
 const fmt=x=>String(Number(x.toFixed(2))),sentence=x=>x?x.replace(/[.\s]+$/,'')+'.':'';
 function pressure(d){
  const blocked=d.envelope==='No measurable TR jet'||d.envelope==='Inadequate envelope'||d.quality==='unreliable';
  const velocity=!blocked&&d.velocityUsable!==false&&pos(d.velocity)?d.velocity:null;
  const direct=!blocked&&d.gradientUsable!==false&&pos(d.gradient)?d.gradient:null;
  const gradient=direct!==null?direct:velocity!==null?4*(velocity/100)**2:null;
  const rap=d.rapUsable!==false&&ok(d.rap)&&d.rap>=0?d.rap:null;
  const rvsp=gradient!==null&&rap!==null?gradient+rap:null;
  return {gradient,rap,rvsp,pasp:rvsp!==null&&d.obstruction==='yes'?rvsp:null,source:direct!==null?'gradient':velocity!==null?'velocity':null,velocity,blocked};
 }
 function pressureText(p){
  if(p.gradient===null)return p.blocked?'TR Doppler is not measurable or reliable. RVSP cannot be estimated from TR.':'RVSP cannot be estimated from the supplied parameters.';
  const parts=[];if(p.source==='velocity')parts.push('TR Vmax '+fmt(p.velocity)+' cm/s.');
  parts.push('TR max gradient '+fmt(p.gradient)+' mmHg.');
  if(p.rap!==null)parts.push('Estimated RAP '+fmt(p.rap)+' mmHg. Estimated RVSP '+fmt(p.rvsp)+' mmHg'+(p.pasp!==null?' (PASP)':'')+'.');
  else parts.push('RVSP cannot be calculated without an RAP estimate.');
  return parts.join(' ');
 }
 function quickValues(d){
  const pair=pos(d.sept)&&pos(d.lat)?(d.sept+d.lat)/2:null;
  const ep=d.relaxSource==='average'?d.average:d.relaxSource==='septal'?d.sept:d.relaxSource==='lateral'?d.lat:pair;
  const epSite=['septal','lateral'].includes(d.relaxSource)?d.relaxSource:'average';
  const epCut=epSite==='septal'?6:epSite==='lateral'?7:6.5;
  const eeSite=d.eeMethod==='calculated'?epSite:d.eeSite||'average';
  const ee=d.eeMethod==='calculated'?(pos(d.e)&&pos(ep)?d.e/ep:null):d.ee;
  const ea=d.eaMethod==='inflow'?(pos(d.e)&&pos(d.a)&&d.separated?d.e/d.a:null):d.ea;
  const sd=d.pvMethod==='ratio'?d.sd:pos(d.pvs)&&pos(d.pvd)?d.pvs/d.pvd:null;
  const pressure=d.paspReliable&&pos(d.pasp)?d.pasp>=35:d.trReliable&&pos(d.tr)?d.tr>=280:null;
  const measured={relax:pos(ep)?ep<=epCut:null,ee:pos(ee)?ee>=(eeSite==='septal'?15:eeSite==='lateral'?13:14):null,pressure,lars:ok(d.lars)?d.lars<=18:null,lavi:pos(d.lavi)?d.lavi>34:null,pv:pos(sd)?sd<=.67:null,ivrt:pos(d.ivrt)?d.ivrt<=70:null,ea:pos(ea)?ea<=.8?'low':ea>=2?'high':'middle':null};
  const conflicts=[];for(const [key,value]of Object.entries(measured)){const selected=d.selection?.[key];if(value===null||!selected||selected==='na'||selected==='fusion')continue;const expected=key==='ea'?value:value?'yes':'no';if(selected!==expected)conflicts.push(key);}
  return {ep:pos(ep)?ep:null,epSite,ee:pos(ee)?ee:null,eeSite,ea:pos(ea)?ea:null,sd:pos(sd)?sd:null,measured,conflicts};
 }
 // Numeric evidence fills only automatic selections. Explicit exclusions and manual choices retain priority.
 function resolveChoices(selection,origins,measured,allowed={}){
  const values={...selection},sources={...origins};
  for(const key of ['relax','ee','pressure','ea','lars','lavi','pv','ivrt']){
   const source=origins[key]|| (selection[key]?'manual':'auto');
   if(source==='manual')continue;
   const val=measured[key];
   if(allowed[key]!==false&&val!==null&&val!==undefined){values[key]=key==='ea'?val:val?'yes':'no';sources[key]='auto';}
   else if(source==='auto'){values[key]='';sources[key]='auto';}
  }
  return {values,sources};
 }
 function massText(m){
  if(!m.type)return '';
  const labels={vegetation:'Suspected vegetation',thrombus:'Suspected thrombus',mass:'Intracardiac mass'};
  let first=labels[m.type]||'Intracardiac mass';if(m.location)first+=' at '+m.location;if(m.site)first+=' ('+m.site.trim()+')';
  const unit=m.unit==='cm'?'cm':'mm',scale=unit==='cm'?10:1;const dims=[m.length,m.width,m.depth].filter(pos);if(dims.length)first+=', measuring '+dims.map(x=>fmt(x/scale)).join(' × ')+' '+unit;
  const details=[m.shape,m.surface,m.echo,m.texture,m.mobility,m.attachment].filter(Boolean).map(x=>x.toLowerCase());
  return [sentence(first),details.length?sentence(details[0].charAt(0).toUpperCase()+details.join(', ').slice(1)):'',sentence(m.notes||'')].filter(Boolean).join(' ');
 }
 const labels={mv:'mitral',av:'aortic',tv:'tricuspid',pv:'pulmonary'};
 const valveSpecs={
  reg:[['vc','Vena contracta','cm'],['eroa','EROA','cm²'],['rvol','Regurgitant volume','mL'],['rf','Regurgitant fraction','%'],['pht','Pressure half-time','ms']],
  sten:[['vmax','Peak velocity','m/s'],['peak','Peak gradient','mmHg'],['mean','Mean gradient','mmHg'],['area','Valve area','cm²'],['dvi','DVI',''],['svi','Stroke volume index','mL/m²'],['pht','Pressure half-time','ms'],['hr','Heart rate','bpm']]
 };
 function valveText(id,d,brief=false){
  const parts=[];for(const [key,name]of [['reg','regurgitation'],['sten','stenosis']]){const x=d[key]||{};if(!x.state)continue;if(x.state==='none'){parts.push('No '+labels[id]+' '+name+'.');continue;}
   const severity=x.severity;parts.push(severity&&severity!=='Indeterminate'?severity+' '+labels[id]+' '+name+'.':labels[id][0].toUpperCase()+labels[id].slice(1)+' '+name+'; severity indeterminate.');
   if(brief)continue;
   if(x.mechanism)parts.push(sentence(x.mechanism));if(x.direction)parts.push(sentence(x.direction+' jet'));if(x.timing)parts.push(sentence(x.timing));if(x.flow)parts.push(sentence(x.flow));
   for(const [k,label,unit]of valveSpecs[key])if(pos(x[k]))parts.push(label+' '+fmt(x[k])+(unit?' '+unit:'')+'.');
  }return parts.join(' ');
 }
