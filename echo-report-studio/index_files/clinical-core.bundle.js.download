/* measurement-units.js */
/* Compatible input units only. Original field IDs and stored values retain their clinical units. */
(function(root){
 'use strict';
 const families={
  length:{mm:1,cm:10,m:1000},area:{'mm²':1,'cm²':100,'m²':1000000},
  velocity:{'cm/s':1,'m/s':100},time:{ms:1,s:1000},pressure:{mmHg:1,kPa:7.5006168270417},
  volume:{mL:1,L:1000},indexedVolume:{'mL/m²':1,'L/m²':1000},weight:{kg:1,lb:.45359237},
  percent:{'%':1},ratio:{ratio:1},rate:{bpm:1},age:{years:1}
 };
 const fields={};
 const add=(ids,base,options)=>ids.split(' ').filter(Boolean).forEach(id=>fields[id]={base,options:options||[base]});
 add('height','cm',['cm','m','mm']);add('weight','kg',['kg','lb']);add('bsa','m²',['m²','cm²']);
 add('ivsd lvidd lvpwd tapse ivc laDiameter raMajor raMinor rvBasal rvMid rvLength gaRoot gaAscending gaAnnulus gaStj gaMpa gaRpa gaLpa gaAscendingDistance','cm',['cm','mm']);
 add('maxwall','mm',['mm','cm']);
 add('e a sept lat sprime tr septA latA pvs pvd lwave quickAvgE','cm/s',['cm/s','m/s']);
 add('prVel lvotrest lvotprov midrest midprov apicalrest apicalprov','m/s',['m/s','cm/s']);
 add('sbp dbp rap pred trGradient paspDirect paDirect','mmHg',['mmHg','kPa']);
 add('dt ivrt arDuration aDuration','ms',['ms','s']);
 add('lavol lvEdv lvEsv raVolume la4Record la2Record','mL',['mL','L']);
 add('laArea raArea rvEda rvEsa','cm²',['cm²','mm²']);
 add('laviDirect','mL/m²',['mL/m²','L/m²']);add('ef efLow efHigh fac lars','%');
 add('valsalvaEA quickEeValue quickEaValue quickPvValue','ratio');add('hr','bpm');add('age','years');
 for(const prefix of ['lvMass','mass1','mass2','mass3'])for(const key of ['Length','Width','Depth'])add(prefix+key,'mm',['mm','cm']);
 const valve={mv:{reg:['vc','eroa','rvol','rf'],sten:['mean','area','pht','hr']},av:{reg:['vc','eroa','rvol','rf','pht'],sten:['vmax','peak','mean','area','dvi','svi']},tv:{reg:['vc','eroa','rvol','rf'],sten:['mean','area','hr']},pv:{reg:['rf','pht'],sten:['vmax','peak','mean']}};
 const specs={vc:['cm',['cm','mm']],eroa:['cm²',['cm²','mm²']],rvol:['mL',['mL','L']],rf:['%'],pht:['ms',['ms','s']],vmax:['m/s',['m/s','cm/s']],peak:['mmHg',['mmHg','kPa']],mean:['mmHg',['mmHg','kPa']],area:['cm²',['cm²','mm²']],dvi:['ratio'],svi:['mL/m²',['mL/m²','L/m²']],hr:['bpm']};
 for(const [id,lesions]of Object.entries(valve))for(const [key,items]of Object.entries(lesions))for(const item of items)add(id+key+item,...specs[item]);
 function convert(value,from,to){
  if(value===null||value===undefined||String(value).trim()==='')return null;
  const x=Number(value);if(!Number.isFinite(x))return null;
  const family=Object.values(families).find(f=>Object.hasOwn(f,from)&&Object.hasOwn(f,to));
  if(!family)throw new Error('Incompatible measurement units: '+from+' / '+to);
  return x*family[from]/family[to];
 }
 const format=value=>value===null||!Number.isFinite(value)?'':String(Number(value.toPrecision(14)));
 const allowed=(id,unit)=>!!fields[id]?.options.includes(unit);
 const api={fields,convert,format,allowed};
 root.MeasurementUnits=api;if(typeof module!=='undefined')module.exports=api;
})(typeof window!=='undefined'?window:globalThis);

