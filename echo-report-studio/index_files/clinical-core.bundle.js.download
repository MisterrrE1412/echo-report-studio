 '<path d="M245 219 L245 182 M238 186 L245 178 L252 186 M238 215 L245 223 L252 215" stroke="#168386" stroke-width="3" fill="none"/>'+
 label('IVC',156,225)+label('RA',433,157)+label('Diameter + respiratory change',250,294)+label('Long-axis IVC schematic',270,34))},
 modes:{title:'PW and CW sampling',svg:wrap('Comparison of pulsed and continuous wave Doppler sampling',
 '<path d="M100 50 L40 289 L245 289 Z M368 50 L303 289 L508 289 Z" fill="#edf3f7" stroke="#cadae3"/>'+
 '<path d="M100 50 L158 287 M368 50 L428 287" stroke="#27898d" stroke-width="3" stroke-dasharray="8 5"/>'+
 '<path d="M124 162 L145 157 M130 187 L151 182" stroke="#b66030" stroke-width="5"/>'+
 '<path d="M368 70 L424 274" stroke="#b66030" stroke-width="5"/>'+
 label('PW',140,325)+label('CW',408,325)+label('Selected depth',140,351)+label('Along the whole beam',408,351))}
 };
