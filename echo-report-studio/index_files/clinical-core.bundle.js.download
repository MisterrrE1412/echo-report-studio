/* great-arteries-core.js */
/* Great-artery measurements: ASE/EACVI 2015 §§11–13; ASE right heart 2025, Tables 1–2. */
(function(root){
 'use strict';
 const sites=[
  {key:'root',id:'gaRoot',name:'Aortic root (sinuses of Valsalva)',brief:'Aortic root',group:'aorta',indexed:true,meaning:'Bahagian aorta yang membonjol tepat di atas injap aorta. Ukur diameter maksimum sinus; bukan annulus.',tip:'PLAX yang fokus pada aorta. End-diastole, leading edge to leading edge; tegak lurus paksi aorta.',example:'Aortic root 3.2 cm.'},
  {key:'ascending',id:'gaAscending',name:'Proximal ascending aorta',brief:'Ascending aorta',group:'aorta',indexed:true,meaning:'Bahagian tubular selepas sinotubular junction (STJ). Cari diameter terbesar yang dapat dilihat.',tip:'PLAX / high parasternal view. End-diastole, leading edge to leading edge; elakkan potongan oblique.',example:'Proximal ascending aorta 4.2 cm.'},
  {key:'annulus',id:'gaAnnulus',name:'Aortic annulus',brief:'Aortic annulus',group:'aorta',extra:true,meaning:'Gelang maya pada tapak perlekatan cusp. Ukuran ini berbeza daripada aortic root.',tip:'Zoomed PLAX, midsystole. Ukur hinge point ke hinge point, inner edge to inner edge.',example:'Aortic annulus 2.1 cm.'},
  {key:'stj',id:'gaStj',name:'Sinotubular junction (STJ)',brief:'Sinotubular junction',group:'aorta',extra:true,meaning:'Tempat sinus aorta berakhir dan bahagian tubular ascending aorta bermula.',tip:'PLAX, end-diastole, leading edge to leading edge; ukur tegak lurus paksi aorta.',example:'Sinotubular junction 2.8 cm.'},
  {key:'mpa',id:'gaMpa',name:'Main pulmonary artery (MPA)',brief:'Main pulmonary artery',group:'pa',meaning:'Salur utama selepas pulmonary valve, sebelum bercabang menjadi RPA dan LPA.',tip:'PA-focused PSAX. End-diastole, di pertengahan antara pulmonary valve dan PA bifurcation.',example:'Main pulmonary artery 2.8 cm.'},
  {key:'rpa',id:'gaRpa',name:'Right pulmonary artery (RPA)',brief:'Right pulmonary artery',group:'pa',extra:true,meaning:'Cabang pulmonary artery ke paru-paru kanan. Rekod hanya jika sempadan salur dapat dikenal pasti.',tip:'PA bifurcation view, ukur bahagian proximal cabang pada end-diastole.',example:'Right pulmonary artery 1.7 cm.'},
  {key:'lpa',id:'gaLpa',name:'Left pulmonary artery (LPA)',brief:'Left pulmonary artery',group:'pa',extra:true,meaning:'Cabang pulmonary artery ke paru-paru kiri. Jangan guna cut-off MPA untuk cabang ini.',tip:'PA bifurcation view, ukur bahagian proximal cabang pada end-diastole.',example:'Left pulmonary artery 1.6 cm.'}
 ];
 const positive=x=>typeof x==='number'&&Number.isFinite(x)&&x>0;
 const numeric=x=>x===null||x===undefined||String(x).trim()===''?null:Number(x);
 const fmt=x=>String(Number(x.toFixed(2)));
 const excluded=new Set(['notmeasurable','unreliable','na']);
 function paGrade(value,age){
  if(!positive(value)||(positive(age)&&age<18))return null;
  // Table 1 explicitly includes 2.5 cm in mild enlargement; the narrative says >25 mm.
  return value<2.5?'Normal':value<=3?'Mild':value<=3.5?'Moderate':'Severe';
 }
 function assess(data={}){
  const body=[],conclusion=[],errors=[],rows={};
  const bsa=numeric(data.bsa),age=numeric(data.age),distance=numeric(data.ascendingDistance);
  for(const site of sites){
   const input=data.measurements?.[site.key]||{},value=numeric(input.value),state=input.state||'';
   const usable=positive(value)&&!excluded.has(state);
   if(value!==null&&!excluded.has(state)&&!positive(value))errors.push(site.brief+' diameter must be greater than zero (cm).');
   const grade=site.key==='mpa'&&usable&&state!=='measurement'?paGrade(value,age):null;
   if(grade&&((state==='normal'&&grade!=='Normal')||(state==='dilated'&&grade==='Normal')))errors.push('Review main pulmonary artery size: the selected assessment conflicts with the ASE 2025 adult diameter category. Correct the value, or choose Measurement only for a separate clinical interpretation.');
   const index=usable&&site.indexed&&positive(bsa)?value/bsa:null;
   rows[site.key]={value,usable,state,index,grade};
   if(state==='na')continue;
   if(state==='notmeasurable'){body.push(site.brief+' not adequately visualized for measurement.');conclusion.push(site.brief+' assessment limited by visualization.');continue;}
   if(state==='unreliable'){body.push(site.brief+' measurement unreliable.');continue;}
   let line=usable?site.name+' '+fmt(value)+' cm':'';
   if(line&&site.key==='ascending'&&positive(distance))line+=' ('+fmt(distance)+' cm above STJ)';
   if(line)body.push(line+'.');
   if(index!==null)body.push(site.brief+' index '+fmt(index)+' cm/m².');
   let interpretation=state==='normal'?'normal size':state==='dilated'?'dilated':'';
   if(grade)interpretation={Normal:'normal size',Mild:'mildly dilated',Moderate:'moderately dilated',Severe:'severely dilated'}[grade];
   if(usable)conclusion.push(site.brief+' '+fmt(value)+' cm'+(interpretation?', '+interpretation:'')+'.');
   else if(interpretation){const text=interpretation==='normal size'?'Normal '+site.brief.toLowerCase()+' size.':'Dilated '+site.brief.toLowerCase()+'.';conclusion.push(text);if(state==='dilated')body.push(text);}
  }
  if(distance!==null&&!positive(distance))errors.push('Ascending aorta measurement distance must be greater than zero (cm).');
  if(data.notes&&String(data.notes).trim()){
   const note=String(data.notes).trim().replace(/[.!?]*$/,'')+'.';body.push(note);conclusion.push(note);
  }
  return {body:body.join(' '),conclusion:conclusion.join(' '),rows,errors};
 }
 const api={sites,paGrade,assess};
 if(typeof module==='object'&&module.exports)module.exports=api;else root.GreatArteries=api;
})(typeof globalThis!=='undefined'?globalThis:this);

