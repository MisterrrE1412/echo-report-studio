/* diastolic-quick.js */
// Categorical selection uses no fabricated measurement values.
(function(root){
function assessQuick(d){
 const tri=x=>x==='yes'?true:x==='no'?false:null;
 const primary=[d.relax,d.ee,d.pressure].map(tri),count=primary.filter(x=>x===true).length;
 const result=(grade,lap,reason,additional=false,code='')=>({grade,lap,reason,additional,code,primary,dd:null,label:grade===0?'Normal diastolic function':grade?'Grade '+['','I','II','III'][grade]+' diastolic dysfunction':'Indeterminate',summary:'',avg:null,ee:null,ea:null,pasp:null,reasons:[]});
 if(d.context!=='general'||d.excluded)return result(null,null,'Confirm an eligible adult resting study in sinus rhythm. Special populations require condition-specific assessment.');

 if(d.ea==='fusion')return result(null,null,'E/A unavailable or fused. Do not force a conventional diastolic grade.',false,'fusion');
 const raised=()=>{if(primary[2]===null&&primary[0]===false&&[d.diagnosticEe===true,d.lars==='yes',d.lavi==='yes',['low','high'].includes(d.ea)].filter(Boolean).length<2)return result(null,'elevated','Additional findings support elevated LAP; preserved relaxation requires an integrated dysfunction assessment before assigning a grade.');return ['low','middle','high'].includes(d.ea)?result(d.ea==='high'?3:2,'elevated','Elevated LAP established. '+(d.ea==='high'?'Restrictive filling pattern.':'E/A <2.')):result(null,'elevated','Elevated LAP; obtain a reliable E/A ratio to distinguish Grade II from Grade III.');};
 if(primary[0]===null||primary[1]===null)return result(null,null,'Missing: '+[primary[0]===null?'e′ relaxation':null,primary[1]===null?'E/e′':null].filter(Boolean).join(' and ')+'. Enter reliable values or select the assessed finding. N/A is unavailable, not normal.',false,'missing_primary');
 if(count===3)return raised();
 if(count===0&&primary[2]!==null)return result(0,'normal','All three primary criteria are normal. Review any discordant diagnostic findings.');
 if(primary[0]&&count===1&&primary[2]===false&&d.ea==='low')return result(1,'normal','Reduced relaxation, normal E/e′ and pulmonary pressure, with E/A ≤0.8.');
 if(primary[0]&&count===1&&primary[2]===false&&(!d.ea||d.ea==='na'))return result(null,null,'Select E/A: ≤0.8 may complete Grade I without additional measurements.');
 const fallback=[['LARS',d.lars],['LAVI',d.lavi],['PV S/D',d.pv]].filter(x=>['yes','no'].includes(x[1]));
 if(!fallback.length&&['yes','no'].includes(d.ivrt))fallback.push(['IVRT',d.ivrt]);
 if(fallback.some(x=>x[1]==='yes'))return raised();
 if(!fallback.length)return result(null,null,(primary[2]===null?'TR/PASP is unavailable. ':'')+'LAP is not established. Enter reliable LARS, LAVI, pulmonary vein S/D or IVRT; confirm applicability where requested.',true,'lap_incomplete');
 if(primary[2]===null)return result(null,null,'TR is not measurable. A negative fallback alone does not establish normal LAP; review integrated findings or use a manual interpretation.',true,'lap_unresolved');
 if(fallback.length===1&&fallback[0][0]==='PV S/D'&&d.preservedEF){if(d.ivrt==='yes')return raised();if(d.ivrt!=='no')return result(null,null,'With preserved or unknown EF, PV S/D >0.67 needs IVRT or another suitable marker.',true);}
 return result(1,'normal','Additional findings support normal resting LAP: Grade I pathway in ASE 2025 Figure 3.');
}
root.assessQuickDiastolic=assessQuick;if(typeof module!=='undefined')module.exports=assessQuick;
})(typeof window!=='undefined'?window:globalThis);

