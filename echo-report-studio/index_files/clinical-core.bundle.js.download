 ]},
 {id:'ph',title:'Pulmonary hypertension assessment',aliases:['ph','pah','pulmonary hypertension','pulm hypertension'],aim:'Assess right-heart structure, function and pressure indicators.',refs:['right'],views:['a4c','saxMid','subcostal'],caution:'No measurable TR is not normal pressure. Echo findings require clinical integration; PH confirmation / classification may require right-heart catheterization.',items:[
 row('rv','RV / RA size; TAPSE, S′ and FAC','2D / M-mode / TDI','RV-focused A4C','Record right-heart size and function.','tapse'),
 row('tr','Maximum reliable TR velocity','Color / CW','Multiple windows','RVSP estimates PASP only without pulmonary / RVOT obstruction.','tr'),
 row('ivc','IVC / RAP; septal shape and pulmonary artery','2D','Subcostal and PSAX','Assess pressure-overload signs.','ivc'),
 row('cause','Left-heart and valve assessment','2D / Doppler','Comprehensive views','Evaluate contributing disease.','rvnotes'),
