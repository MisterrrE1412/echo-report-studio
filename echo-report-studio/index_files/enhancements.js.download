fill($('patient'),[F('age','Age (years)','number'),F('sbp','Systolic BP (mmHg)','number'),F('dbp','Diastolic BP (mmHg)','number')]);
// Diastolic assessment controls, derived values, and accessible 17-segment editor.
fill(dg,[F('scope','Applicable study population','select',[['','Select clinical context'],['general','Adult, resting study — no listed exception'],['af','Atrial fibrillation / atrial flutter'],['mitral','Severe primary MR / any MS / moderate–severe MAC'],['repair','Mitral repair / replacement / TEER'],['ph','Non-cardiac PH / pulmonary parenchymal or vascular disease'],['htx','Heart transplant / LVAD'],['constriction','Pericardial constriction'],['conduction','LBBB / AV conduction disorder / ventricular pacing'],['hcm','HCM / restrictive cardiomyopathy — specialist review'],['other','Child / normal pregnancy / intraoperative / other exception']]),F('signals','Entered Doppler / TDI measurements','select',[['','Confirm signal quality'],['yes','Reliable, correctly acquired measurements'],['no','Insufficient / unreliable signals']]),F('tdiSource','TDI site used for grading','select',[['average','Average (both sites)'],['septal','Septal only'],['lateral','Lateral only']]),F('pressureReliable','TR / PASP suitability','select',[['','Not confirmed'],['yes','Reliable signal; no non-cardiac cause of PH'],['no','Unreliable / not applicable']]),F('noObstruction','RVOT / pulmonary valve obstruction','select',[['','Not assessed — use TR velocity'],['yes','Absent — RVSP may estimate PASP'],['no','Present — do not equate RVSP with PASP']]),F('laviDirect','Measured LAVI, if known (mL/m²)','number'),F('laReliable','LAVI suitable for diastolic assessment','select',[['','Not confirmed / exclude from grading'],['yes','Reliable; other causes of LA enlargement excluded']]),F('lars','LA reservoir strain, LARS (%)','number'),F('pvs','Pulmonary vein S velocity (cm/s)','number'),F('pvd','Pulmonary vein D velocity (cm/s)','number'),F('pvReliable','Pulmonary vein S/D applicability','select',[['','Not confirmed / exclude from grading'],['yes','Reliable and clinically applicable']]),F('ivrt','IVRT (ms)','number'),F('septA','Septal a′ (cm/s), optional','number'),F('latA','Lateral a′ (cm/s), optional','number'),F('prVel','PR end-diastolic velocity (m/s)','number'),F('lwave','Mitral L-wave velocity (cm/s)','number'),F('arDuration','Pulmonary vein Ar duration (ms)','number'),F('aDuration','Mitral A duration (ms)','number'),F('valsalvaEA','E/A during Valsalva','number'),F('massReliable','LV mass suitability (Figure 2)','select',[['','Not confirmed / exclude LVMI marker'],['yes','Reliable; athletic remodelling excluded']]),F('overrideReason','Reason for manual interpretation override','textarea')]);
// Keep shared measurements in one place; the RV and LA report uses the same values.
for(const id of ['tr','lavol','lamethod','rap','notr'])dg.append($(id).parentElement);
const intro=document.createElement('p');intro.className='note';intro.textContent='ASE 2025 • General resting sinus-rhythm pathway. Enter only reliable values. TR, RAP and LA measurements here are shared with the rest of the report. Values update automatically.';dg.prepend(intro);
const contexts=document.createElement('div');contexts.className='grid wide';for(const id of ['scope','signals','tdiSource','pressureReliable','noObstruction'])contexts.append($(id).parentElement);intro.after(contexts);
const derived=document.createElement('div');derived.className='derived wide';derived.id='diaDerived';contexts.after(derived);
const decision=document.createElement('div');decision.id='diaDecision';decision.className='decision wide';derived.after(decision);
$('diastolic').parentElement.style.gridColumn='1 / -1';
const ref=document.createElement('p');ref.className='note';ref.innerHTML='Reference: <a href="https://www.asecho.org/wp-content/uploads/2025/07/Left-Ventricular-Diastolic-Function.pdf" target="_blank" rel="noopener">ASE 2025, Table 3 and Figures 2–3 (pp. 541, 553–554)</a>. Uses fixed Figure 3 cutoffs, not age-adjusted thresholds. E/A alone never sets a grade. DT and a′ are recorded but are not independent grading criteria. Unavailable TR/PASP returns incomplete assessment; it is never counted as normal.';dg.append(ref);
function diaData(){const c=calculate();return{scope:present(n('age'))&&n('age')<18?'child':v('scope'),rhythm:v('rhythm'),fused:v('fused'),reliable:v('signals')==='yes',tdiSource:v('tdiSource'),sept:n('sept'),lat:n('lat'),e:n('e'),a:n('a'),tr:present(n('tr'))?n('tr')/100:null,rap:c.rap,noTR:v('notr')==='No measurable TR jet',pressureReliable:v('pressureReliable')==='yes',noObstruction:v('noObstruction')==='yes',rvObstruction:v('noObstruction')==='no',lavi:c.lavi,laReliable:v('laReliable')==='yes',lars:n('lars'),sd:positive(n('pvs'))&&positive(n('pvd'))?n('pvs')/n('pvd'):null,pvReliable:v('pvReliable')==='yes',ivrt:n('ivrt'),preservedEF:v('efMethod')==='visual'?(!present(n('efHigh'))||n('efHigh')>=50):!present(n('ef'))||n('ef')>=50,lvmi:c.lvmi,sex:v('sex'),massReliable:v('massReliable')==='yes',prVel:n('prVel'),paedp:present(n('pred'))&&present(c.rap)?n('pred')+c.rap:null,lwave:n('lwave'),arDiff:present(n('arDuration'))&&present(n('aDuration'))?n('arDuration')-n('aDuration'):null,valsalvaDrop:positive(n('e'))&&positive(n('a'))&&present(n('valsalvaEA'))?(1-n('valsalvaEA')/(n('e')/n('a')))*100:null}}
function diastolicAssessment(){return assessDiastolic(diaData())}
function diastolicMeasurements(){const d=diaData(),a=assessDiastolic(d);let values=[];for(const [label,value,unit]of [['Average e′',a.avg,'cm/s'],['LAVI',d.lavi,'mL/m²'],['LARS',d.lars,'%'],['Pulmonary vein S/D',d.sd,''],['IVRT',d.ivrt,'ms'],['Septal a′',n('septA'),'cm/s'],['Lateral a′',n('latA'),'cm/s'],['PR end-diastolic velocity',d.prVel,'m/s'],['Mitral L wave',d.lwave,'cm/s'],['Pulmonary Ar−A duration',d.arDiff,'ms'],['E/A decrease during Valsalva',d.valsalvaDrop,'%']])if(present(value))values.push(label+' '+r(value)+' '+unit+'.');return values.join(' ')}
function updateDiastolic(){const d=diaData(),a=assessDiastolic(d);derived.replaceChildren();for(const[label,val,unit]of [['Average e′',a.avg,'cm/s'],['Average E/e′',a.ee,''],['E/A',a.ea,''],['LAVI',d.lavi,'mL/m²'],['PASP',a.pasp,'mmHg'],['PV S/D',d.sd,'']]){let cell=document.createElement('div');let l=document.createElement('small');l.textContent=label;let b=document.createElement('strong');b.textContent=present(val)?r(val):'—';let u=document.createElement('span');u.textContent=unit;cell.append(l,b,u);derived.append(cell)}decision.replaceChildren();let title=document.createElement('h3');title.textContent=a.label;let reason=document.createElement('p');reason.textContent=a.reason;let path=document.createElement('ul');a.reasons.forEach(t=>{let li=document.createElement('li');li.textContent=t;path.append(li)});let df=document.createElement('p');df.textContent='Figure 2 dysfunction markers: '+(a.dd===true?'criteria met':a.dd===false?'criteria not met':'incomplete')+'.';decision.append(title,reason,path,df);decision.dataset.grade=a.grade===null?'unknown':a.grade;let ov=$('overrideReason').parentElement;ov.hidden=!v('diastolic');$('overrideReason').required=!!v('diastolic');}
// AHA 17-segment polar map: anterior up, septal left, inferior down, lateral right.
const names={'':'Unspecified','1':'Normal','2':'Hypokinesia','3':'Akinesia','4':'Dyskinesia','x':'Not visualized'};
const fills={'':'#e4ebf0','1':'#c6e9e4','2':'#f7da8b','3':'#efad87','4':'#d69bc7','x':'#bac4d0'};
const symbols={'':'—','1':'N','2':'H','3':'A','4':'D','x':'X'};
const box=document.createElement('div');box.className='bullseye wide';wg.prepend(box);let help=document.createElement('p');help.className='note';help.textContent='Right-click, click or tap a segment to mark its motion. Keyboard: Tab to a segment, then Enter or Space. Numbers follow the AHA 17-segment model.';box.append(help);
const svgNS='http://www.w3.org/2000/svg';const svg=document.createElementNS(svgNS,'svg');svg.setAttribute('viewBox','0 0 400 410');svg.setAttribute('aria-label','17-segment LV bullseye wall motion editor');svg.classList.add('polar');box.append(svg);
function sv(tag,attrs){let e=document.createElementNS(svgNS,tag);Object.entries(attrs).forEach(([k,v])=>e.setAttribute(k,v));return e}function pt(radius,angle){return [200+radius*Math.cos(angle*Math.PI/180),205+radius*Math.sin(angle*Math.PI/180)]}
for(const[label,x,y]of [['ANTERIOR',200,20],['INFERIOR',200,403],['SEPTAL',24,205],['LATERAL',376,205]]){let t=sv('text',{x,y,'text-anchor':'middle',class:'orientation'});t.textContent=label;if(label==='SEPTAL'||label==='LATERAL')t.setAttribute('transform',`rotate(${label==='SEPTAL'?-90:90} ${x} ${y})`);svg.append(t)}
let polarGroups=[];segments.forEach((name,i)=>{let inner,outer,angle,half;if(i<6){inner=112;outer=166;angle=-90-i*60;half=30}else if(i<12){inner=65;outer=112;angle=-90-(i-6)*60;half=30}else if(i<16){inner=25;outer=65;angle=-90-(i-12)*90;half=45}else{inner=0;outer=25;angle=0;half=180}let group=sv('g',{tabindex:'0',role:'button','aria-label':`${i+1}. ${name}: Unspecified`,'data-segment':i+1});let shape;if(i===16)shape=sv('circle',{cx:200,cy:205,r:25});else{let a=pt(outer,angle-half),b=pt(outer,angle+half),c=pt(inner,angle+half),d=pt(inner,angle-half);shape=sv('path',{d:`M${a} A${outer},${outer} 0 0 1 ${b} L${c} A${inner},${inner} 0 0 0 ${d} Z`})}shape.setAttribute('fill',fills['']);shape.setAttribute('stroke','#ffffff');shape.setAttribute('stroke-width','2');let loc=i===16?[200,205]:pt((outer+inner)/2,angle);let num=sv('text',{x:loc[0],y:loc[1]-3,'text-anchor':'middle',class:'segmentNumber'});num.textContent=i+1;let status=sv('text',{x:loc[0],y:loc[1]+13,'text-anchor':'middle',class:'segmentMotion'});status.textContent='—';let title=sv('title',{});title.textContent=name;group.append(shape,num,status,title);group.addEventListener('click',()=>openSegment(i));group.addEventListener('contextmenu',e=>{e.preventDefault();openSegment(i)});group.addEventListener('keydown',e=>{if(['Enter',' '].includes(e.key)){e.preventDefault();openSegment(i)}});svg.append(group);polarGroups.push({group,shape,status,title});});
let legend=document.createElement('div');legend.className='legend';for(const key of ['1','2','3','4','x','']){let l=document.createElement('span');let chip=document.createElement('i');chip.style.background=fills[key];l.append(chip,document.createTextNode(symbols[key]+' '+names[key]));legend.append(l)}box.append(legend);
let all=document.createElement('button');all.type='button';all.textContent='Mark remaining visualized segments normal';all.onclick=()=>{segments.forEach((s,i)=>{if(!v('s'+i))$('s'+i).value='1'});synchronizeMotion();changed()};box.append(all);let summary=document.createElement('p');summary.className='wall-summary';box.append(summary);
const table=document.createElement('details');table.className='wide';let ts=document.createElement('summary');ts.textContent='Segment list and scores';table.append(ts);let grid=document.createElement('div');grid.className='grid';segments.forEach((s,i)=>grid.append($('s'+i).parentElement));table.append(grid);wg.append(table);
const dialog=document.createElement('dialog');dialog.className='motion-dialog';dialog.setAttribute('aria-labelledby','segmentTitle');dialog.innerHTML='<div class="dialoghead"><h2 id="segmentTitle"></h2><button type="button" aria-label="Close segment editor">✕</button></div><p>Select wall motion</p><div class="motion-options"></div>';document.body.append(dialog);dialog.querySelector('button').onclick=()=>dialog.close();dialog.addEventListener('click',e=>{if(e.target===dialog)dialog.close()});let selected=0,motionTrigger=null;for(const key of ['1','2','3','4','x','']){let b=document.createElement('button');b.type='button';b.dataset.score=key;b.innerHTML='<i></i><span></span>';b.querySelector('i').style.background=fills[key];b.querySelector('span').textContent=names[key]+(/^[1-4]$/.test(key)?' · score '+key:'');b.onclick=()=>{materializeScores();$('s'+selected).value=key;synchronizeMotion();changed();dialog.close();(motionTrigger||polarGroups[selected].group).focus()};dialog.querySelector('.motion-options').append(b)}
function openSegment(i){motionTrigger=document.activeElement;selected=i;$('segmentTitle').textContent=(i+1)+'. '+segments[i];let code=effectiveCode(i);dialog.querySelectorAll('[data-score]').forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.score===code)));dialog.showModal()}
function effectiveCode(i){if(v('s'+i))return v('s'+i);return v('motion')==='Global hypokinesia'?'2':v('motion')==='No RWMA'||v('remaining')==='normal'?'1':''}
function materializeScores(){segments.forEach((s,i)=>$('s'+i).value=effectiveCode(i));$('remaining').value='';$('motion').value=''}
function synchronizeMotion(){let codes=segments.map((s,i)=>v('s'+i));$('motion').value=codes.every(x=>x==='1'||x==='x')&&codes.includes('1')?'No RWMA':codes.every(x=>x==='2'||x==='x')&&codes.includes('2')?'Global hypokinesia':codes.some(x=>['2','3','4'].includes(x))?'Regional wall motion abnormality':'';$('remaining').value=''}
let lastBullseyeCodes='';
function updateBullseye(){const signature=segments.map((_,i)=>effectiveCode(i)).join('|');if(signature===lastBullseyeCodes)return;lastBullseyeCodes=signature;polarGroups.forEach((o,i)=>{let code=effectiveCode(i);o.shape.setAttribute('fill',fills[code]);o.status.textContent=symbols[code];o.group.setAttribute('aria-label',`${i+1}. ${segments[i]}: ${names[code]}`);o.title.textContent=`${segments[i]} — ${names[code]}`});let c=calculate();summary.textContent=c.count?`WMSI ${r(c.wmsi)} · total ${c.total} / ${c.count} assessed segments${c.count<16?' · partial assessment':''}`:'No segments assessed'}
function changed(){$('form').dispatchEvent(new Event('input',{bubbles:true}))}
$('form').addEventListener('input',e=>{if(/^s\d+$/.test(e.target.id||'')){const id=e.target.id,chosen=v(id);materializeScores();$(id).value=chosen;synchronizeMotion();}});
$('form').addEventListener('clinicalupdate',()=>{updateBullseye();updateDiastolic();renderMetrics(calculate())});
for(const id of ['lars']){$(id).max='100';$(id).min='0';}for(const id of ['e','a','sept','lat','tr','laviDirect','ivrt'])$(id).min='0.001';
updateBullseye();updateDiastolic();renderMetrics(calculate());
