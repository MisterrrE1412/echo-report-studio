const OCR_LIMITS={count:6,bytes:12e6,edge:1600,pixels:24000000};
let ocrFiles=[],ocrWorker=null,ocrBusy=false,ocrCancelled=false,ocrLoader=null,ocrCancelReject=null;
function queueStatus(index,text){$('imageQueue').children[index].textContent=ocrFiles[index].name+' — '+text;}
$('echoImage').onchange=()=>{
 const files=Array.from($('echoImage').files);$('readImage').disabled=true;ocrFiles=[];$('imageQueue').replaceChildren();
 $('ocrCandidates').replaceChildren();$('applyOcr').disabled=true;$('ocrText').value='';
 if(files.length>OCR_LIMITS.count||files.some(f=>f.size>OCR_LIMITS.bytes||!['image/png','image/jpeg','image/webp'].includes(f.type))){$('ocrStatus').textContent='Choose up to 6 PNG, JPEG or WebP images, each under 12 MB.';return;}
 ocrFiles=files;files.forEach((f,i)=>{const row=document.createElement('li');$('imageQueue').append(row);queueStatus(i,'Ready');});
 $('readImage').disabled=!files.length;$('ocrStatus').textContent=files.length+' images ready. Review each measurement before applying.';
};
function loadOCR(){if(window.Tesseract)return Promise.resolve();if(ocrLoader)return ocrLoader;
 ocrLoader=new Promise((resolve,reject)=>{const script=document.createElement('script');script.src='https://cdn.jsdelivr.net/npm/tesseract.js@5.1.1/dist/tesseract.min.js';const fail=()=>{script.remove();ocrLoader=null;reject(new Error('Reader download failed. Try again or enter measurements manually.'));};const timer=setTimeout(fail,25000);script.onload=()=>{clearTimeout(timer);resolve();};script.onerror=()=>{clearTimeout(timer);fail();};document.head.append(script);});return ocrLoader;
}
function timedOCR(promise,ms){let timer;return Promise.race([promise,new Promise((_,reject)=>{ocrCancelReject=reject;timer=setTimeout(()=>reject(new Error('Reader timed out. Try a smaller crop.')),ms);})]).finally(()=>{clearTimeout(timer);ocrCancelReject=null;});}
async function prepareOCRImage(file){
 const url=URL.createObjectURL(file),img=new Image();let canvas;
 try{await new Promise((resolve,reject)=>{img.onload=resolve;img.onerror=()=>reject(new Error('Image could not be opened.'));img.src=url;});
  if(img.naturalWidth*img.naturalHeight>OCR_LIMITS.pixels)throw new Error('Image too large. Crop the measurement area first.');
  const scale=Math.min(1,OCR_LIMITS.edge/Math.max(img.naturalWidth,img.naturalHeight));canvas=document.createElement('canvas');canvas.width=Math.max(1,Math.round(img.naturalWidth*scale));canvas.height=Math.max(1,Math.round(img.naturalHeight*scale));
  const context=canvas.getContext('2d');context.fillStyle='#fff';context.fillRect(0,0,canvas.width,canvas.height);context.drawImage(img,0,0,canvas.width,canvas.height);return canvas;
 }catch(e){if(canvas){canvas.width=canvas.height=1;}throw e;}finally{img.src='';URL.revokeObjectURL(url);}
}
$('cancelOcr').onclick=()=>{ocrCancelled=true;if(ocrCancelReject)ocrCancelReject(new Error('Reading cancelled.'));$('cancelOcr').disabled=true;$('ocrStatus').textContent='Cancelling…';if(ocrWorker){ocrWorker.terminate();ocrWorker=null;}};
$('readImage').onclick=async()=>{
 if(ocrBusy||!ocrFiles.length)return;ocrBusy=true;ocrCancelled=false;
 $('readImage').disabled=true;$('echoImage').disabled=true;$('cancelOcr').hidden=false;$('cancelOcr').disabled=false;$('parseText').disabled=true;$('applyOcr').disabled=true;$('ocrText').value='';$('ocrCandidates').replaceChildren();
 let completed=0,failed=0;
 try{
  $('ocrStatus').textContent='Loading image reader…';await timedOCR(loadOCR(),26000);if(ocrCancelled)return;
  const pending=Tesseract.createWorker('eng',1,{workerPath:'https://cdn.jsdelivr.net/npm/tesseract.js@5.1.1/dist/worker.min.js',corePath:'https://cdn.jsdelivr.net/npm/tesseract.js-core@5.1.1',langPath:'https://tessdata.projectnaptha.com/4.0.0'});
  let expired=false;pending.then(w=>{if(expired||ocrCancelled)w.terminate();},()=>{});
  try{ocrWorker=await timedOCR(pending,45000);}catch(e){expired=true;throw e;}if(ocrCancelled)return;
  for(let i=0;i<ocrFiles.length&&!ocrCancelled;i++){
   let canvas;queueStatus(i,'Reading');$('ocrStatus').textContent='Reading image '+(i+1)+' of '+ocrFiles.length+'…';
   try{canvas=await prepareOCRImage(ocrFiles[i]);if(ocrCancelled)break;const result=await timedOCR(ocrWorker.recognize(canvas),60000);if(ocrCancelled)break;
    $('ocrText').value+='\n\nImage '+(i+1)+': '+ocrFiles[i].name+'\n'+result.data.text;completed++;queueStatus(i,'Read — review measurements');
   }catch(e){if(ocrCancelled)break;failed++;queueStatus(i,e.message||'Failed');if(/timed out/.test(e.message))throw e;
   }finally{if(canvas)canvas.width=canvas.height=1;}
  }
 }catch(e){$('ocrStatus').textContent=e.message||'Unable to read images.';}
 finally{
  if(ocrWorker){try{await ocrWorker.terminate();}catch{}ocrWorker=null;}
  if(completed){showCandidates();$('ocrStatus').textContent=completed+' images read'+(failed?', '+failed+' failed':'')+(ocrCancelled?' · Cancelled':'')+'. '+$('ocrStatus').textContent;}
  else if(ocrCancelled)$('ocrStatus').textContent='Reading cancelled. You can try again.';
  if(ocrCancelled)ocrFiles.forEach((_,i)=>{if(/Ready|Reading$/.test($('imageQueue').children[i].textContent))queueStatus(i,'Cancelled');});
  ocrBusy=false;$('echoImage').disabled=false;$('readImage').disabled=!ocrFiles.length;$('cancelOcr').hidden=true;$('parseText').disabled=false;
 }
};
