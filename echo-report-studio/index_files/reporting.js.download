function measurementGrades(c=calculate()){
 const d={sex:v('sex'),lvmi:c.lvmi,mass:c.mass,rw:c.rw,lavi:c.lavi,rap:c.rap,rvsp:c.trpg&&present(c.rap)?c.trpg+c.rap:null,pressureReliable:v('pressureReliable')==='yes'};
 for(const key of ['age','ef','lvidd','ivsd','lvpwd','tapse','sprime','fac','ivc'])d[key]=n(key);
 const grades=ReportCore.classify(d);if(v('efMethod')==='visual')grades.ef=currentEF().grade;return grades;
}
function gradeSuffix(grade){return grade?' ('+grade.toLowerCase()+')':'';}
const gradingPanel=document.createElement('details');gradingPanel.className='grading-panel';gradingPanel.open=true;gradingPanel.innerHTML='<summary>Automatic measurement grading</summary><div id="measurementGrades" class="grade-list" aria-live="polite"></div><p class="note">Adult references. Quantitative LV and LA grades take priority over manual size/function selections. RV measures are graded individually; overall RV function requires integrated assessment. No stand-alone severity is assigned to E, A, DT, heart rate, or measurements without an applicable ASE severity scale.</p>';$('sections').before(gradingPanel);
const gradeLabels={geometry:'LV geometry',ef:'LVEF',lvidd:'LVIDd',ivsd:'IVSd',lvpwd:'LVPWd',mass:'LV mass',lvmi:'LVMI',rw:'RWT',lavi:'LAVI',tapse:'TAPSE',sprime:'RV S′',fac:'RV FAC',ivc:'IVC',rap:'RAP',rvsp:'RVSP / PASP'};
function updateMeasurementGrades(){const grades=measurementGrades(),root=$('measurementGrades');root.replaceChildren();for(const [key,grade]of Object.entries(grades)){if(!grade)continue;let p=document.createElement('p');let strong=document.createElement('strong');strong.textContent=gradeLabels[key]+': ';p.append(strong,document.createTextNode(grade));root.append(p);}if(!root.children.length)root.textContent='Enter measurements to see applicable grades.';if(!v('sex')&&['ef','ivsd','lvpwd','lvidd'].some(id=>v(id))){let p=document.createElement('p');p.textContent='Select sex for sex-specific LV reference ranges.';root.append(p);}if(present(n('age'))&&n('age')<18)root.textContent='Adult cutoffs are not applied to patients under 18.';for(const id of ['ef','lvidd','ivsd','lvpwd','tapse','sprime','fac','ivc']){let badge=$(id+'Grade');if(!badge){badge=document.createElement('small');badge.id=id+'Grade';badge.className='auto-grade';$(id).after(badge);}badge.textContent=grades[id]||'';}
 const c=calculate();let geometry=$('lvGeometry');if(!geometry){geometry=document.createElement('p');geometry.id='lvGeometry';geometry.className='wide auto-grade';$('lvpwd').parentElement.after(geometry);}geometry.textContent=grades.geometry?'LV geometry: '+grades.geometry+' (RWT '+r(c.rw)+', LVMI '+r(c.lvmi,1)+' g/m²).':'LV geometry requires RWT, LVMI and sex. Enter LVIDd, LVPWd, IVSd and BSA (or height/weight).';if(present(n('age'))&&n('age')<18)geometry.textContent='Adult LV geometry criteria are not applied under age 18.';let rw=$('motionDescription');if(!rw){rw=document.createElement('p');rw.id='motionDescription';rw.className='motion-description';document.querySelector('.wall-summary').after(rw);}rw.textContent=ReportCore.motionText(c.scores,segments)||(c.count?'Normal motion in assessed segments.':'No segments assessed.');
}
$('form').addEventListener('clinicalupdate',updateMeasurementGrades);updateMeasurementGrades();
const sourceNote=document.createElement('p');sourceNote.innerHTML='Automatic grades: <a href="https://www.asecho.org/wp-content/uploads/2016/02/2015_ChamberQuantificationREV.pdf" target="_blank" rel="noopener">ASE/EACVI chamber quantification, Supplemental Table 3 (2015)</a>; <a href="https://www.asecho.org/wp-content/uploads/2025/03/PIIS0894731725000379.pdf" target="_blank" rel="noopener">ASE right heart, Table 1 (2025)</a>. Continuous values use the upper normal/mild/moderate limits; shared TAPSE 1.3 cm and S′ 7.2 cm/s endpoints are labelled borderline. Pressure grades describe the estimated pressure, not a diagnosis of pulmonary hypertension. Valve grading requires integrated valve measurements.';document.querySelector('.reference').append(sourceNote);
// Serialize the actual editable preview. Never copy layout, controls or raw HTML.
function previewBlocks(root=$('report')){return ReportCore.domBlocks(root);}
function reportClipboard(){return ReportCore.serialize(previewBlocks());}
function copyFallback(text){const area=document.createElement('textarea');area.value=text;area.style.position='fixed';area.style.left='-10000px';document.body.append(area);area.select();const ok=document.execCommand('copy');area.remove();if(!ok)throw new Error('Copy not available');}
async function copyReport(plain=false){if(!generated||dirty){toast('Generate the updated report before copying.');return;}const data=reportClipboard();try{if(!plain&&navigator.clipboard?.write&&window.ClipboardItem){await navigator.clipboard.write([new ClipboardItem({'text/plain':new Blob([data.text],{type:'text/plain'}),'text/html':new Blob([data.html],{type:'text/html'})})]);toast('Report copied with headings and plain-text fallback.');return;}}catch{/* Rich clipboard may be blocked by the receiving browser. */}try{if(navigator.clipboard?.writeText)await navigator.clipboard.writeText(data.text);else copyFallback(data.text);toast('Clean hospital text copied.');}catch{try{copyFallback(data.text);toast('Clean hospital text copied.');}catch{toast('Copy blocked. Use Download text, or select and copy the preview.');}}}
$('copy').textContent='Copy formatted';$('copy').onclick=()=>copyReport(false);
const plainCopy=document.createElement('button');plainCopy.id='copyPlain';plainCopy.textContent='Copy hospital text';plainCopy.className='primary';plainCopy.disabled=true;plainCopy.onclick=()=>copyReport(true);$('copy').before(plainCopy);
const copyActions=$('copy').parentElement;document.querySelector('.reportpaper').before(copyActions);
const copyHint=document.createElement('p');copyHint.className='hint';copyHint.textContent='For hospital free-text fields, use Copy hospital text. Plain text cannot retain a chosen font or bold. Copy hospital text: plain text with uppercase headings and consistent spacing. Copy formatted: Arial with bold headings where supported. The hospital system controls the pasted font and may remove bold.';$('copy').parentElement.after(copyHint);
const observer=new MutationObserver(()=>{plainCopy.disabled=$('copy').disabled});observer.observe($('copy'),{attributes:true,attributeFilter:['disabled']});
$('download').onclick=()=>{const url=URL.createObjectURL(new Blob([reportClipboard().text],{type:'text/plain;charset=utf-8'}));const a=document.createElement('a');a.href=url;a.download='echo-report.txt';a.click();setTimeout(()=>URL.revokeObjectURL(url),1000);};
$('report').addEventListener('copy',e=>{const selection=window.getSelection();if(!selection||selection.isCollapsed||!$('report').contains(selection.anchorNode)||!$('report').contains(selection.focusNode))return;const container=document.createElement('div');container.append(selection.getRangeAt(0).cloneContents());const data=ReportCore.serialize(previewBlocks(container));if(e.clipboardData){e.preventDefault();e.clipboardData.setData('text/plain',data.text);e.clipboardData.setData('text/html',data.html);}});

// A selectable text view remains usable when clipboard APIs are blocked.
const textView=document.createElement('details');textView.className='hospital-text-view';textView.innerHTML='<summary>Hospital text preview / manual copy</summary><textarea id="hospitalText" readonly aria-label="Hospital plain text report" spellcheck="false"></textarea><button id="selectHospitalText" type="button">Select all text</button>';
copyHint.after(textView);
function refreshHospitalText(){const text=$('hospitalText');text.value=generated&&!dirty&&textView.open?ReportCore.serialize(previewBlocks()).text:'';text.placeholder=dirty?'Findings changed. Generate the updated report first.':'Generate a report to preview the hospital text.';}
$('selectHospitalText').onclick=()=>{$('hospitalText').focus();$('hospitalText').select();};
new MutationObserver(refreshHospitalText).observe($('report'),{childList:true,subtree:true,characterData:true});
$('form').addEventListener('input',refreshHospitalText);
textView.addEventListener('toggle',refreshHospitalText);
refreshHospitalText();
