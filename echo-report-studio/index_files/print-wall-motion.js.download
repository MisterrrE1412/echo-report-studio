// A print-only snapshot keeps diagrams out of the editable report and clipboard.
(function(){
const printRoot=document.createElement('article');printRoot.id='pdfReport';document.body.append(printRoot);
function copyDiagram(source,title){const figure=document.createElement('figure'),caption=document.createElement('figcaption');caption.textContent=title;const drawing=source.cloneNode(true);drawing.removeAttribute('class');drawing.removeAttribute('style');drawing.querySelectorAll('[tabindex],[role=button]').forEach(el=>{el.removeAttribute('tabindex');el.removeAttribute('role');});drawing.querySelectorAll('title').forEach(el=>el.remove());figure.append(caption,drawing);return figure;}
function buildPrintSnapshot(){
 if(!generated||dirty){printRoot.replaceChildren();return false;}
 // Flush diagram colours even when Print follows a segment selection immediately.
 $('form').dispatchEvent(new Event('clinicalupdate'));updateBullseye();
 printRoot.replaceChildren();const title=document.createElement('h1');title.textContent='Transthoracic Echocardiogram';printRoot.append(title);
 const text=document.createElement('div');text.className='pdf-text';text.innerHTML=safeReportHTML($('report').innerHTML);printRoot.append(text);
 const panel=document.createElement('section');panel.className='pdf-motion';panel.setAttribute('aria-label','Regional wall motion diagrams');const h=document.createElement('h2');h.textContent='Regional Wall Motion';panel.append(h);
 const grid=document.createElement('div');grid.className='pdf-motion-grid';const views=Array.from(document.querySelectorAll('.wall-view'));
 views.slice(0,3).forEach((view,i)=>grid.append(copyDiagram(view.querySelector('svg'),['Short axis — basal','Short axis — mid','Short axis — apical'][i])));
 grid.append(copyDiagram(svg,'17-segment bullseye'));
 views.slice(3).forEach((view,i)=>{const figure=copyDiagram(view.querySelector('svg'),['Apical 4-chamber','Apical 3-chamber','Apical 2-chamber'][i]);figure.className='pdf-apical';grid.append(figure);});panel.append(grid);
 const key=legend.cloneNode(true);key.className='pdf-motion-legend';panel.append(key);
 const c=calculate(),detail=document.createElement('p');detail.className='pdf-motion-summary';detail.textContent=c.count?'WMSI '+r(c.wmsi)+' • '+c.count+'/16 segments assessed. Apical cap excluded from WMSI.':'Wall motion not assessed. Unspecified segments have not been assumed normal.';panel.append(detail);
 const conclusion=Array.from(text.querySelectorAll('h3')).find(el=>/^conclusion\s*:?$/i.test(el.textContent.trim()));if(conclusion)conclusion.before(panel);else text.append(panel);
 return true;
}
$('print').onclick=()=>{if(!buildPrintSnapshot()){toast('Generate the updated report before printing.');return;}document.body.classList.add('echo-pdf');window.print();};
window.addEventListener('beforeprint',()=>{if(buildPrintSnapshot())document.body.classList.add('echo-pdf');});
window.addEventListener('afterprint',()=>{document.body.classList.remove('echo-pdf');printRoot.replaceChildren();});
})();
